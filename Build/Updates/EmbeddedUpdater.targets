<Project>
  <PropertyGroup>
    <UpdatePublicKeyFile Condition="'$(UpdatePublicKeyFile)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)update-public.pem'))</UpdatePublicKeyFile>
    <EmbeddedUpdaterSelfContained>false</EmbeddedUpdaterSelfContained>
    <EmbeddedUpdaterSelfContained Condition="'$(SelfContained)' == 'true'">true</EmbeddedUpdaterSelfContained>
    <EmbeddedUpdaterDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\embedded-updater\$(EmbeddedUpdaterSelfContained)\'))</EmbeddedUpdaterDirectory>
    <EmbeddedUpdaterFile>$(EmbeddedUpdaterDirectory)FMLauncher.Updater.exe</EmbeddedUpdaterFile>
  </PropertyGroup>
  <ItemGroup>
    <_UpdaterSource Include="$(MSBuildThisFileDirectory)..\..\FMLauncher.Updater\*.cs;$(MSBuildThisFileDirectory)..\..\FMLauncher.Updater\*.csproj;$(MSBuildThisFileDirectory)..\..\FMLauncher.UpdateShared\*.cs;$(MSBuildThisFileDirectory)..\..\FMLauncher.UpdateShared\*.csproj;$(MSBuildThisFileFullPath)"/>
    <_UpdaterSource Include="$(UpdatePublicKeyFile)" Condition="Exists('$(UpdatePublicKeyFile)')"/>
    <EmbeddedResource Include="$(EmbeddedUpdaterFile)" LogicalName="FMLauncher.EmbeddedUpdater"/>
    <EmbeddedResource Include="$(UpdatePublicKeyFile)" LogicalName="FMLauncher.UpdatePublicKey" Condition="Exists('$(UpdatePublicKeyFile)')"/>
  </ItemGroup>
  <!-- 默认复用启动器已依赖的 .NET 10 运行时，不重复内嵌运行库。
       显式自包含发布时保留更新器的独立运行能力；按模式分开缓存，避免复用错误产物。 -->
  <Target Name="PublishEmbeddedUpdater" BeforeTargets="PrepareForBuild" Inputs="@(_UpdaterSource)" Outputs="$(EmbeddedUpdaterFile)" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\FMLauncher.Updater\FMLauncher.Updater.csproj" Targets="Restore;Publish"
             RemoveProperties="TargetFramework;TargetFrameworks"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=$(EmbeddedUpdaterSelfContained);PublishSingleFile=true;PublishTrimmed=false;PublishReadyToRun=false;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=$(EmbeddedUpdaterSelfContained);DebugType=None;PublishDir=$(EmbeddedUpdaterDirectory);UpdatePublicKeyFile=$(UpdatePublicKeyFile)"/>
  </Target>
</Project>
