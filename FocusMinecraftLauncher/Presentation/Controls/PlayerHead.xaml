<UserControl x:Class="FocusMinecraftLauncher.Presentation.Controls.PlayerHead"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Root" Focusable="False" UseLayoutRounding="True">
    <Grid RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
        <Image Source="/FocusMinecraftLauncher;component/Presentation/Assets/DefaultPlayerHead.png" Stretch="Uniform" AutomationProperties.Name="默认玩家头像"/>
        <Image x:Name="HeadImage" Source="{Binding Source, ElementName=Root}" Stretch="Uniform" ImageFailed="HeadFailed"/>
    </Grid>
</UserControl>
