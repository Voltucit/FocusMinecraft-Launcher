<UserControl x:Class="FocusMinecraftLauncher.Presentation.Controls.MemoryAllocationPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" Focusable="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SubtleBorder}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius16}" Padding="24">
        <StackPanel>
            <WrapPanel>
                <RadioButton Content="自动配置" IsChecked="{Binding IsAutomatic, Mode=TwoWay}" MinHeight="32"
                             Margin="0,0,24,0" FocusVisualStyle="{StaticResource FocusVisual}"/>
                <RadioButton Content="自定义" IsChecked="{Binding IsCustom, Mode=TwoWay}" MinHeight="32"
                             FocusVisualStyle="{StaticResource FocusVisual}"/>
            </WrapPanel>
            <TextBlock Text="{Binding AutomaticMemoryHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Visibility="{Binding IsAutomatic, Converter={StaticResource BoolVisibility}}"/>
            <Slider Minimum="{Binding MinimumMemoryGb}" Maximum="{Binding MaximumMemoryGb}"
                    Value="{Binding AllocatedMemoryGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="0.5" SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True" IsEnabled="{Binding CanAdjustMemory}" MinHeight="40" Margin="0,12,0,0"
                    Foreground="{DynamicResource PrimaryBackground}" FocusVisualStyle="{StaticResource FocusVisual}"
                    AutomationProperties.Name="游戏内存分配，单位 GB" ToolTip="{Binding AllocationText}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding MinimumMemoryGb, StringFormat={}{0:0.0} GB}" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="1" Text="{Binding MaximumMemoryText}" Style="{StaticResource Caption}"/>
            </Grid>
            <CheckBox Content="启动前释放启动器可回收内存" IsChecked="{Binding OptimizeBeforeLaunch, Mode=TwoWay}"/>
            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="系统已使用 / 总内存" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="游戏分配" Style="{StaticResource Caption}" Margin="16,0,0,0"/>
                    </Grid>
                    <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8"
                                 IsEnabled="{Binding HasSystemMemory}" AutomationProperties.Name="系统内存使用率" ToolTip="{Binding UsageText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="{Binding UsedMemoryText, Mode=OneWay}" d:Text="10.4 GB"/>
                            <Run Text=" / " Foreground="{DynamicResource MutedText}"/>
                            <Run Text="{Binding TotalMemoryText, Mode=OneWay}" Foreground="{DynamicResource MutedText}" d:Text="16 GB"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding AllocationText}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding AvailableMemoryText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
