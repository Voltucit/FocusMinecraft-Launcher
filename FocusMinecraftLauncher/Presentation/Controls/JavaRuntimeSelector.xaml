<UserControl x:Class="FocusMinecraftLauncher.Presentation.Controls.JavaRuntimeSelector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 Focusable="False" Foreground="{DynamicResource AppText}">
    <ui:AnimatedExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" AutomationProperties.Name="选择本机 Java">
        <ui:AnimatedExpander.Header><TextBlock Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectedPath}"/></ui:AnimatedExpander.Header>
        <StackPanel Margin="12,0,12,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <fluent:Button Content="检测本机 Java" Command="{Binding Detect}" Margin="0,0,8,0"/>
                <fluent:Button Content="下载 Java" Command="{Binding Install}" AutomationProperties.Name="下载官方 Java 运行时"/>
            </StackPanel>
            <ProgressBar Value="{Binding InstallProgress, Mode=OneWay}" Maximum="100" Visibility="{Binding IsInstalling, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Java 下载进度" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding InstallStatus}" Visibility="{Binding InstallStatus, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Java 检测进度" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasFailed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <fluent:Button Content="自动选择" Command="{Binding SelectAutomatic}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12" MinHeight="48" AutomationProperties.Name="自动选择合适的 Java"/>
            <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate>
                <fluent:Button Command="{Binding DataContext.Select, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,4,0,0" ToolTip="{Binding Path}">
                    <fluent:Button.Style><Style TargetType="fluent:Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/></DataTrigger></Style.Triggers></Style></fluent:Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Headline}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0" ToolTip="{Binding Headline}"/>
                        <TextBlock Grid.Column="1" Text="当前选择" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"/>
                    </Grid>
                </fluent:Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ui:AnimatedExpander>
</UserControl>
