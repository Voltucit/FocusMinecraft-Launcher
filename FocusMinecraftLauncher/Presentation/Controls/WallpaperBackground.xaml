<UserControl x:Class="FocusMinecraftLauncher.Presentation.Controls.WallpaperBackground"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
    <Grid>
        <MediaElement x:Name="VideoLayer" Stretch="UniformToFill" Visibility="Collapsed" IsMuted="True"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"/>
        <Grid x:Name="WebHost" Visibility="Collapsed"/>
        <!-- 加载时以预览覆盖播放器，真正就绪后再揭开，不用截图循环代替实时渲染。 -->
        <Image x:Name="ImageLayer" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Background="{DynamicResource BackgroundImageScrim}"/>
    </Grid>
</UserControl>
