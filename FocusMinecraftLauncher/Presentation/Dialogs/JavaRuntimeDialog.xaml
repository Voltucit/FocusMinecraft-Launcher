<Window x:Class="FocusMinecraftLauncher.Presentation.Dialogs.JavaRuntimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource AppText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}"
        visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}">
    <Window.Resources>
        <Style x:Key="DialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource OutlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect" Value="{DynamicResource SoftPopupShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius12}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoftIconBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource DialogSurface}" Margin="20" MouseLeftButtonDown="DragWindow">
        <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource CardCornerRadius}"
                Margin="{DynamicResource OutlineThickness}" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="44" Height="44" VerticalAlignment="Top">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource AccentText}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12 3.5 V14 M8 10.5 L12 14.5 16 10.5 M4.5 16.5 V19.5 H19.5 V16.5"/>
                    </Border>
                    <TextBlock x:Name="Headline" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <TextBlock x:Name="Body" Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap"
                           LineHeight="22" Foreground="{DynamicResource MutedText}"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Margin="0,20,0,0"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <fluent:Button x:Name="CancelButton" Content="取消" MinWidth="88" Margin="0,0,12,0"
                                   IsCancel="True" Click="Decline" AutomationProperties.Name="取消启动"/>
                    <fluent:Button x:Name="HigherButton" Content="用更高版本启动" MinWidth="132" Margin="0,0,12,0"
                                   Click="UseHigher" AutomationProperties.Name="尝试用更高版本的 Java 启动"/>
                    <fluent:Button x:Name="DownloadButton" Content="下载" Style="{StaticResource PrimaryButton}"
                                   MinWidth="120" IsDefault="True" Click="Download" AutomationProperties.Name="下载所需 Java"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
