<Window x:Class="FocusMinecraftLauncher.Presentation.Dialogs.ManualPackFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        Title="补齐整合包资源" Width="720" Height="620" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource AppText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}" visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}"
        AutomationProperties.Name="手动补齐整合包资源" KeyDown="WindowKeyDown">
    <Border Background="{DynamicResource PopupSurface}" CornerRadius="{DynamicResource CardCornerRadius}"
            BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="{DynamicResource OutlineThickness}"
            Margin="20" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="补齐整合包资源" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="以下文件无法自动下载。请从官网获取指定版本，再选择下载的文件。"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,12,0,16"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="0,12,4,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding File.FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding File.FileName}"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="{Binding SourcePath}" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <fluent:Button Grid.Column="1" Content="官网" Style="{StaticResource QuietButton}" Padding="10,6" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.OpenPage, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="打开指定版本的官方页面" AutomationProperties.Name="打开资源官网"/>
                                    <fluent:Button Grid.Column="2" Content="选择文件" Style="{StaticResource QuietButton}" Padding="10,6" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.SelectFile, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="选择资源文件"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="{Binding Notice}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding Notice, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <fluent:Button Content="批量选择文件" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Command="{Binding SelectMany}" AutomationProperties.Name="批量选择已下载资源"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <fluent:Button Content="取消" Style="{StaticResource QuietButton}" MinWidth="80" Click="Cancel" AutomationProperties.Name="取消导入"/>
                    <fluent:Button Content="继续安装" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0" IsEnabled="{Binding CanContinue}" Click="Continue" IsDefault="True" AutomationProperties.Name="校验完成后继续安装"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
