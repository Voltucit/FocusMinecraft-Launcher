<Window x:Class="FocusMinecraftLauncher.Presentation.Dialogs.YggdrasilProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource AppText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}"
        visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}">
    <Window.Resources>
        <Style x:Key="DialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource OutlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect" Value="{DynamicResource SoftPopupShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="{DynamicResource Radius8}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" Style="{StaticResource DialogSurface}" Margin="20" MouseLeftButtonDown="DragWindow">
        <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource CardCornerRadius}"
                Margin="{DynamicResource OutlineThickness}" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择角色" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Margin="0,10,0,16" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{DynamicResource MutedText}"
                           Text="这个账号在验证服务里有多个角色，选择本次登录使用的角色。"/>
                <StackPanel x:Name="Options" Grid.Row="2"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <fluent:Button Content="取消" MinWidth="96" Margin="0,0,12,0" IsCancel="True" Click="Decline"/>
                    <fluent:Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="Accept"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
