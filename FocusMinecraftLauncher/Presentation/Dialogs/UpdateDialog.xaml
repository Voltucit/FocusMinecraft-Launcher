<Window x:Class="FocusMinecraftLauncher.Presentation.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource AppText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}"
        visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}">
    <Window.Resources>
        <!-- 与提示卡、整合包确认卡共用主题表面：Soft 去描边补阴影，Flat 保留直角描边。 -->
        <Style x:Key="DialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource OutlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect" Value="{DynamicResource SoftPopupShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius12}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoftIconBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" Style="{StaticResource DialogSurface}" Margin="20" MouseLeftButtonDown="DragWindow">
        <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource CardCornerRadius}"
                Margin="{DynamicResource OutlineThickness}" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="44" Height="44" VerticalAlignment="Top">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource AccentText}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12 4 V14 M7.5 9.5 L12 14 16.5 9.5 M4.5 18.5 H19.5"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VersionLine" Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource ControlHover}"
                        CornerRadius="{DynamicResource Radius12}" Padding="16,12">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesBlock" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedText}"/>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisibility}}">
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="4"/>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Text="{Binding Status}"/>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Transfer}"
                               Visibility="{Binding Transfer, Converter={StaticResource TextVisibility}}"/>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Margin="0,20,0,0"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <fluent:Button Content="稍后" Style="{StaticResource QuietButton}" MinWidth="88" Margin="0,0,8,0"
                                   Click="Later" AutomationProperties.Name="稍后提醒"/>
                    <fluent:Button Content="查看更新内容" Style="{StaticResource QuietButton}" MinWidth="112" Margin="0,0,8,0"
                                   Click="OpenPage" AutomationProperties.Name="查看更新内容"/>
                    <fluent:Button x:Name="ActionButton" Content="立即下载" Style="{StaticResource PrimaryButton}"
                                   MinWidth="112" IsDefault="True" Click="Act" AutomationProperties.Name="立即下载更新"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
