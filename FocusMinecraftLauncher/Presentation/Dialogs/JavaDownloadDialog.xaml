<Window x:Class="FocusMinecraftLauncher.Presentation.Dialogs.JavaDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource AppText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}"
        visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}">
    <Window.Resources>
        <!-- 与提示卡片共用主题表面：Soft 去描边补阴影，Flat 保留 1px 直角描边。 -->
        <Style x:Key="DialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource OutlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect" Value="{DynamicResource SoftPopupShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VersionOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource SubtleBorder}" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource AccentText}" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius12}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoftIconBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource DialogSurface}" Margin="20" MouseLeftButtonDown="DragWindow">
        <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource CardCornerRadius}"
                Margin="{DynamicResource OutlineThickness}" Padding="28,24">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="44" Height="44" VerticalAlignment="Top">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource AccentText}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12 3 V14.5 M7.5 10.5 L12 15 L16.5 10.5 M4 19.5 H20"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="下载 Java" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="选择要下载的官方运行时，安装完成后会自动选中。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Margin="0,20,0,0"/>
                <StackPanel Margin="0,16,0,16">
                    <RadioButton x:Name="Option8" GroupName="JavaVersion" Style="{StaticResource VersionOption}" Tag="8" Margin="0,0,0,14" AutomationProperties.Name="Java 8">
                        <StackPanel>
                            <TextBlock Text="Java 8" FontWeight="Medium"/>
                            <TextBlock Text="1.12.2 及更早的 Forge、老版本 OptiFine" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Option16" GroupName="JavaVersion" Style="{StaticResource VersionOption}" Tag="16" Margin="0,0,0,14" AutomationProperties.Name="Java 16">
                        <StackPanel>
                            <TextBlock Text="Java 16" FontWeight="Medium"/>
                            <TextBlock Text="1.17 的早期版本" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Option17" GroupName="JavaVersion" Style="{StaticResource VersionOption}" Tag="17" Margin="0,0,0,14" AutomationProperties.Name="Java 17">
                        <StackPanel>
                            <TextBlock Text="Java 17" FontWeight="Medium"/>
                            <TextBlock Text="1.18 至 1.20.4" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Option21" GroupName="JavaVersion" Style="{StaticResource VersionOption}" Tag="21" Margin="0,0,0,14" AutomationProperties.Name="Java 21">
                        <StackPanel>
                            <TextBlock Text="Java 21" FontWeight="Medium"/>
                            <TextBlock Text="1.20.5 及之后（含 26.x）" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Option25" GroupName="JavaVersion" Style="{StaticResource VersionOption}" Tag="25" AutomationProperties.Name="Java 25">
                        <StackPanel>
                            <TextBlock Text="Java 25" FontWeight="Medium"/>
                            <TextBlock Text="最新的官方运行时" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <fluent:Button Content="取消" MinWidth="96" Margin="0,0,12,0" IsCancel="True" Click="Decline" AutomationProperties.Name="取消下载"/>
                    <fluent:Button Content="下载" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="Accept" AutomationProperties.Name="开始下载 Java"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
