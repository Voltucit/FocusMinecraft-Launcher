<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls">
    <!-- 独立预设：只在选中时装入，卸载后恢复基础资源和其他主题。日间纸色取近白灰而非纯白，避免整屏刺眼。 -->
    <SolidColorBrush x:Key="AppBackground" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="ContentScrim" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppText" Color="#000000"/>
    <SolidColorBrush x:Key="MutedText" Color="#595959"/>
    <SolidColorBrush x:Key="CaptionText" Color="#595959"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SubtleBorder" Color="#000000"/>
    <SolidColorBrush x:Key="ControlHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedText" Color="#000000"/>
    <SolidColorBrush x:Key="NavigationSelectedBackground" Color="#000000"/>
    <SolidColorBrush x:Key="NavigationSelectedText" Color="#FFFFFF"/>
    <!-- 小字号文字使用黑色；强调色不直接用作白底正文，以保证对比度。 -->
    <SolidColorBrush x:Key="AccentText" Color="#000000"/>
    <SolidColorBrush x:Key="ErrorText" Color="#000000"/>
    <SolidColorBrush x:Key="FlatAccent" Color="#FF3366"/>
    <SolidColorBrush x:Key="FocusRing" Color="#FF3366"/>
    <SolidColorBrush x:Key="PrimaryBackground" Color="#FF3366"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#000000"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#000000"/>
    <SolidColorBrush x:Key="CaptionDangerHover" Color="#000000"/>
    <SolidColorBrush x:Key="CaptionDangerPressed" Color="#000000"/>
    <SolidColorBrush x:Key="CaptionDangerForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlatBlack" Color="#000000"/>
    <SolidColorBrush x:Key="FlatWhite" Color="#FFFFFF"/>
    <Thickness x:Key="OutlineThickness">2</Thickness>
    <system:Double x:Key="DisabledOpacity">1</system:Double>
    <system:Double x:Key="AccountDisabledOpacity">1</system:Double>
    <system:Double x:Key="ScrollThumbHoverOpacity">1</system:Double>
    <system:Double x:Key="ScrollThumbDragOpacity">1</system:Double>
    <system:Double x:Key="ScrollThumbOpacity">1</system:Double>
    <system:Double x:Key="FocusCornerRadius">0</system:Double>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="MainPanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SidebarCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="NavigationCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="NavigationFocusCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="DropdownCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="Radius2">0</CornerRadius><CornerRadius x:Key="Radius3">0</CornerRadius>
    <CornerRadius x:Key="Radius4">0</CornerRadius><CornerRadius x:Key="Radius5">0</CornerRadius>
    <CornerRadius x:Key="Radius6">0</CornerRadius><CornerRadius x:Key="Radius7">0</CornerRadius>
    <CornerRadius x:Key="Radius8">0</CornerRadius><CornerRadius x:Key="Radius10">0</CornerRadius>
    <CornerRadius x:Key="Radius12">0</CornerRadius><CornerRadius x:Key="Radius16">0</CornerRadius>

    <!-- 保留 InfoBar 的严重程度图标和文案，所有状态用同一套黑白视觉。 -->
    <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoBarWarningSeverityBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoBarErrorSeverityBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#000000"/>
    <Color x:Key="SystemAccentColorSecondary">#000000</Color>

    <!-- 复用 WPF UI Button 的命令、访问键、自动化和焦点行为，只替换二维外观。 -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="fluent:Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Frame" Background="{DynamicResource FlatWhite}" BorderBrush="{DynamicResource FlatBlack}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border x:Name="Focus" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource FocusRing}" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/><Setter TargetName="Icon" Property="Margin" Value="0"/></Trigger>
            <Trigger Property="Appearance" Value="Primary"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PrimaryBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/></Trigger>
            <Trigger Property="Appearance" Value="Dark"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatBlack}"/><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <Trigger Property="Appearance" Value="Transparent"><Setter TargetName="Frame" Property="BorderThickness" Value="0"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatBlack}"/><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Appearance" Value="Primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatWhite}"/><Setter Property="Foreground" Value="{DynamicResource FlatBlack}"/></MultiTrigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Appearance" Value="Dark"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatWhite}"/><Setter Property="Foreground" Value="{DynamicResource FlatBlack}"/></MultiTrigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatBlack}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatWhite}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MutedText}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="FlatNativeButtonTemplate" TargetType="Button">
        <Border x:Name="Frame" Background="{DynamicResource FlatBlack}" BorderBrush="{DynamicResource FlatBlack}" BorderThickness="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="True"><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatWhite}"/><Setter Property="Foreground" Value="{DynamicResource FlatBlack}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatBlack}"/><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatWhite}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- PART_ContentHost 保留 TextBox 的原生编辑、选择、IME 和滚动，不实现输入逻辑。 -->
    <ControlTemplate x:Key="FlatTextBoxTemplate" TargetType="TextBox">
        <Border x:Name="Frame" Background="{DynamicResource FlatWhite}" BorderBrush="{DynamicResource FlatBlack}" BorderThickness="0,0,0,2">
            <Grid Margin="{TemplateBinding Padding}">
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource MutedText}" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MutedText}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="FlatValidationTemplate"><Border BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"><AdornedElementPlaceholder/></Border></ControlTemplate>
    <ControlTemplate x:Key="FlatMenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Frame" Background="{DynamicResource FlatWhite}" Padding="12,8">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FlatBlack}"/><Setter Property="Foreground" Value="{DynamicResource FlatWhite}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="FlatContextMenuTemplate" TargetType="ContextMenu">
        <Border Background="{DynamicResource FlatWhite}" BorderBrush="{DynamicResource FlatBlack}" BorderThickness="2" Padding="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
    </ControlTemplate>
    <ContextMenu x:Key="FlatEditMenu" x:Shared="False" HasDropShadow="False" Foreground="{DynamicResource FlatBlack}" Template="{StaticResource FlatContextMenuTemplate}">
        <ContextMenu.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="Template" Value="{StaticResource FlatMenuItemTemplate}"/><Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></Style></ContextMenu.ItemContainerStyle>
        <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/><MenuItem Header="复制" Command="ApplicationCommands.Copy"/><MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/><MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
    </ContextMenu>
    <ControlTemplate x:Key="FlatToolTipTemplate" TargetType="ToolTip">
        <Border Background="{DynamicResource FlatWhite}" BorderBrush="{DynamicResource FlatBlack}" BorderThickness="2" Padding="12,8"><ContentPresenter/></Border>
    </ControlTemplate>
    <!-- 未知总量显示静态标记并由现有阶段文字解释，不创建持续的装饰动画。 -->
    <ControlTemplate x:Key="FlatProgressTemplate" TargetType="ProgressBar">
        <Grid x:Name="PART_Track" Background="{DynamicResource FlatWhite}" Height="4">
            <Border x:Name="PART_Indicator" Background="{DynamicResource FlatBlack}" HorizontalAlignment="Left"/>
            <Border x:Name="Unknown" Width="48" Background="{DynamicResource FlatBlack}" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Unknown" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
