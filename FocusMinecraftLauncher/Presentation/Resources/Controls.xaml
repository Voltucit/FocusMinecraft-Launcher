<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
                    xmlns:common="clr-namespace:FocusMinecraftLauncher.Common">
    <!-- Radix Gray 1/2 表面、3/4/5 交互、6/7 边界、11/12 文字；Jade 11 与 Red 11 用于反馈。 -->
    <SolidColorBrush x:Key="AppBackground" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="AppText" Color="#202020"/>
    <SolidColorBrush x:Key="SelectedText" Color="#202020"/>
    <SolidColorBrush x:Key="MutedText" Color="#646464"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="SubtleBorder" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="FocusRing" Color="#646464"/>
    <SolidColorBrush x:Key="PrimaryBackground" Color="#202020"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="AccentText" Color="#208368"/>
    <SolidColorBrush x:Key="ErrorText" Color="#CE2C31"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <common:InverseVisibilityConverter x:Key="NotVisibility"/>
    <common:TextVisibilityConverter x:Key="TextVisibility"/>
    <common:InverseBooleanConverter x:Key="InverseBoolean"/>
    <common:ObjectVisibilityConverter x:Key="ObjectVisibility"/>
    <common:ZeroVisibilityConverter x:Key="ZeroVisibility"/>
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
            <Rectangle Margin="-3" Stroke="{DynamicResource FocusRing}" StrokeThickness="2" RadiusX="{DynamicResource FocusCornerRadius}" RadiusY="{DynamicResource FocusCornerRadius}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 滚动容器自己不该抢焦点环：内容区一旦拿到焦点，整块页面会被描上一圈边框。 -->
    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource CaptionText}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="ErrorMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource TextVisibility}}"/>
    </Style>
    <Style x:Key="ThemePopupSurface" TargetType="Border">
        
        <Setter Property="visual:ThemeVisuals.IsSoft" Value="{DynamicResource SoftEnabled}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Effect" Value="{DynamicResource SoftPopupShadow}"/></DataTrigger>

            
</Style.Triggers>
    </Style>
    <!-- 使用 WPF UI 原生模板，保留库中的按键、焦点、禁用和编辑行为。 -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Radius12}"/>
        <Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatNativeButtonTemplate}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>
</Style.Triggers>
    </Style>
    <Style TargetType="fluent:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius12}"/>
        <Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    <Style.Triggers>
            
            

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatButtonTemplate}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource SoftButtonTemplate}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="visual:SoftMotion.Enabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/></DataTrigger>

            
</Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="fluent:Button" BasedOn="{StaticResource {x:Type fluent:Button}}">
        <Setter Property="Appearance" Value="Primary"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="fluent:Button" BasedOn="{StaticResource {x:Type fluent:Button}}">
        <Setter Property="Appearance" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="fluent:Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
    </Style>
    <!-- 单独出现、需要被认成按钮的危险操作：保留描边与常规内边距。 -->
    <Style x:Key="DangerOutlineButton" TargetType="fluent:Button" BasedOn="{StaticResource {x:Type fluent:Button}}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorText}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Radius12}"/>
        <Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
            
            

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatTextBoxTemplate}"/><Setter Property="CaretBrush" Value="{DynamicResource FlatBlack}"/><Setter Property="SelectionBrush" Value="{DynamicResource FlatBlack}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource FlatWhite}"/><Setter Property="SelectionOpacity" Value="1"/><Setter Property="ContextMenu" Value="{DynamicResource FlatEditMenu}"/><Setter Property="Validation.ErrorTemplate" Value="{DynamicResource FlatValidationTemplate}"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource SoftTextBoxTemplate}"/><Setter Property="visual:SoftMotion.Enabled" Value="True"/><Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBackground}"/><Setter Property="SelectionTextBrush" Value="White"/><Setter Property="SelectionOpacity" Value="1"/><Setter Property="ContextMenu" Value="{DynamicResource SoftEditMenu}"/><Setter Property="Validation.ErrorTemplate" Value="{DynamicResource SoftValidationTemplate}"/></DataTrigger>

            
</Style.Triggers>
    </Style>
    <Style TargetType="fluent:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Radius12}"/>
        <Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="PlaceholderText" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ClearButtonEnabled" Value="False"/>
        <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
            
            

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatTextBoxTemplate}"/><Setter Property="CaretBrush" Value="{DynamicResource FlatBlack}"/><Setter Property="SelectionBrush" Value="{DynamicResource FlatBlack}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource FlatWhite}"/><Setter Property="SelectionOpacity" Value="1"/><Setter Property="ContextMenu" Value="{DynamicResource FlatEditMenu}"/><Setter Property="Validation.ErrorTemplate" Value="{DynamicResource FlatValidationTemplate}"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource SoftTextBoxTemplate}"/><Setter Property="visual:SoftMotion.Enabled" Value="True"/><Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBackground}"/><Setter Property="SelectionTextBrush" Value="White"/><Setter Property="SelectionOpacity" Value="1"/><Setter Property="ContextMenu" Value="{DynamicResource SoftEditMenu}"/><Setter Property="Validation.ErrorTemplate" Value="{DynamicResource SoftValidationTemplate}"/></DataTrigger>

            
</Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{DynamicResource Radius6}" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FlatBlack}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource MutedText}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="12,8,36,8" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="{DynamicResource DropdownHorizontalOffset}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <Border Style="{StaticResource ThemePopupSurface}" Margin="{DynamicResource DropdownPopupMargin}" Padding="4" Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource DropdownCornerRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                        <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
            </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></MultiDataTrigger>
</Style.Triggers>
    </Style>
    <!-- 主题选择框使用独立模板；整块按钮接受点击，文字和箭头不拦截输入。 -->
    <Style TargetType="visual:AnimatedComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="visual:AnimatedComboBox">
            <Grid>
                <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="12,8,36,8" IsHitTestVisible="False" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <Path x:Name="PART_Arrow" Data="M0,0 L4,4 8,0" Width="8" Height="4" Stretch="Uniform" IsHitTestVisible="False"
                      Stroke="{DynamicResource MutedText}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5"/>
                <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="{DynamicResource DropdownHorizontalOffset}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <visual:PopupRevealDecorator x:Name="PART_Reveal" Margin="0,4,0,0">
                        <Border Style="{StaticResource ThemePopupSurface}" Margin="{DynamicResource AnimatedPopupMargin}" Padding="4" Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource DropdownCornerRadius}"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </visual:PopupRevealDecorator>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Border.CornerRadius" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Border.CornerRadius" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!-- 列表项自带 1px 边框表示键盘焦点，不再额外叠一圈 2px 焦点环。 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="{DynamicResource OutlineThickness}" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Trigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FlatBlack}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>            <MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
            </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></MultiDataTrigger>
</Style.Triggers>
    </Style>
    <!-- 关闭动画时，未知总量保留静态标记及阶段文本，不制造百分比。 -->
    <ControlTemplate x:Key="StaticIndeterminateProgress" TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius2}"><Border Width="48" HorizontalAlignment="Center" Background="{TemplateBinding Foreground}" CornerRadius="{DynamicResource Radius2}"/></Border>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Bar" Background="{DynamicResource MutedText}" Opacity="{DynamicResource ScrollThumbOpacity}" CornerRadius="{DynamicResource Radius3}" Margin="4,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="{DynamicResource ScrollThumbHoverOpacity}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="{DynamicResource ScrollThumbDragOpacity}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="Background" Value="{DynamicResource ControlHover}"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="4"/>
        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource Self}}" Value="True"/>
            <Condition Binding="{Binding DataContext.Session.MotionAllowed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
        </MultiDataTrigger.Conditions><Setter Property="Template" Value="{StaticResource StaticIndeterminateProgress}"/></MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatProgressTemplate}"/></DataTrigger>
</Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Frame" Padding="0,8,0,12" Margin="0,0,24,0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                <ContentPresenter x:Name="HeaderText" ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppText}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TabPanel IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="0"/>
                <ContentPresenter x:Name="PART_SelectedContentHost" TextElement.FontWeight="Normal" Grid.Row="1" Margin="0,24,0,0" ContentSource="SelectedContent"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="PART_Header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderFrame" Background="Transparent" CornerRadius="{DynamicResource Radius12}" Padding="12" MinHeight="48">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <visual:DisclosureArrow IsExpanded="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" x:Name="PART_Arrow" Data="M0,0 L4,4 8,0" Width="8" Height="4" Stretch="Uniform" Stroke="{DynamicResource MutedText}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"/>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    </Grid>
                </ToggleButton>
                <visual:RevealDecorator x:Name="PART_Reveal" IsRevealed="{TemplateBinding IsExpanded}"><ContentPresenter ContentSource="Content"/></visual:RevealDecorator>
            </StackPanel>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="InstanceRow">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="32" Height="32" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ControlCornerRadius}" VerticalAlignment="Center">
                <Image Source="{Binding DisplayIcon}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Version}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Loader}" Style="{StaticResource Caption}" Margin="12,0,0,0"/></StackPanel>
                <TextBlock Text="{Binding MetadataIssue}" Foreground="{DynamicResource ErrorText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataIssue}" Visibility="{Binding MetadataIssue, Converter={StaticResource TextVisibility}}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TaskRow">
        <Border Padding="0,20" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Stage}" Style="{StaticResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Margin="0,12,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="任务进度"/>
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasBytes, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding DownloadLabel}" Style="{StaticResource Caption}" Margin="0,0,16,0"/><TextBlock Text="{Binding Speed}" Style="{StaticResource Caption}"/></WrapPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorMessage}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <fluent:Button Content="{Binding CancelText}" Command="{Binding DataContext.Session.CancelTask, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}"/>
                    <fluent:Button Content="重试" Command="{Binding DataContext.Session.RetryTask, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
                    <fluent:Button Content="查看错误详情" Command="{Binding DataContext.Session.ShowTaskError, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" Visibility="{Binding HasFailure, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
    <!-- 原生与自定义折叠框共用动画模板，所有主题遵循同一动画偏好。 -->
    <Style TargetType="visual:AnimatedExpander" BasedOn="{StaticResource {x:Type Expander}}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        
        <Setter Property="visual:ThemeVisuals.IsSoft" Value="{DynamicResource SoftEnabled}"/>
        <Setter Property="visual:ThemeVisuals.IsFlat" Value="{DynamicResource FlatEnabled}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource FlatToolTipTemplate}"/><Setter Property="Foreground" Value="{DynamicResource FlatBlack}"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>

            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource SoftToolTipTemplate}"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/></DataTrigger>

            
</Style.Triggers>
    </Style>
    <Style TargetType="fluent:InfoBar" BasedOn="{StaticResource {x:Type fluent:InfoBar}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Border.CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="{DynamicResource FlatBlack}"/><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>
</Style.Triggers>
    </Style>
    <!-- 首页头像动作按钮与账号菜单：三套布局共用，放在应用级字典里以便独立 UserControl 引用。 -->
    <Style x:Key="AccountAction" TargetType="fluent:Button" BasedOn="{StaticResource {x:Type fluent:Button}}">
        <Setter Property="Padding" Value="4,10"/><Setter Property="Margin" Value="4,0"/><Setter Property="MinHeight" Value="64"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
    </Style>
    <Style x:Key="ActionIcon" TargetType="Path">
        <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=fluent:Button}}"/><Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Style x:Key="AccountMenu" TargetType="ContextMenu">
        <Setter Property="visual:ThemeVisuals.IsSoft" Value="{DynamicResource SoftEnabled}"/>
        <Setter Property="visual:ThemeVisuals.IsFlat" Value="{DynamicResource FlatEnabled}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Background" Value="{DynamicResource PopupSurface}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="MinWidth" Value="240"/><Setter Property="MaxHeight" Value="480"/>
        <Setter Property="DataContext" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource Radius12}" Padding="4">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="HasDropShadow" Value="False"/></DataTrigger>
            <DataTrigger Binding="{Binding Path=(visual:ThemeVisuals.IsSoft), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Template" Value="{DynamicResource SoftContextMenuTemplate}"/><Setter Property="HasDropShadow" Value="False"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AccountMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,8"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="{DynamicResource Radius7}" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path x:Name="Check" Data="M0,5 L4,9 11,1" Stroke="{DynamicResource AppText}" StrokeThickness="1.6" Width="12" Height="10" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(visual:ThemeVisuals.IsFlat), RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FlatBlack}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></MultiDataTrigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuHeading" TargetType="MenuItem" BasedOn="{StaticResource AccountMenuItem}">
        <Setter Property="IsEnabled" Value="False"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="CapeMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AccountMenuItem}">
        <Setter Property="Header" Value="{Binding Alias}"/><Setter Property="IsCheckable" Value="True"/><Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
        <Setter Property="Command" Value="{Binding Command}"/><Setter Property="CommandParameter" Value="{Binding}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Alias}"/>
        <Style.Triggers><DataTrigger Binding="{Binding Id}" Value=""><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SwitchMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AccountMenuItem}">
        <Setter Property="Header" Value="{Binding Title}"/><Setter Property="Command" Value="{Binding Command}"/><Setter Property="CommandParameter" Value="{Binding Parameter}"/>
        <Setter Property="IsCheckable" Value="{Binding IsAccount}"/><Setter Property="IsChecked" Value="{Binding Account.IsCurrent, Mode=OneWay, FallbackValue=False}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter Property="IsEnabled" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border Height="1" Background="{DynamicResource SubtleBorder}" Margin="8,4"/></ControlTemplate></Setter.Value></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MenuSeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="{DynamicResource SubtleBorder}"/></ControlTemplate></Setter.Value></Setter></Style>
    <!-- 头像本身就是菜单入口：去掉按钮外观，只在悬停时给出底色。 -->
    <Style x:Key="AvatarAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius16}" Padding="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/><Setter TargetName="Frame" Property="Padding" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
