<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 柔和夜间：深灰蓝的分层表面，圆角延续原模板，阴影采用低强度黑色。 -->
    <SolidColorBrush x:Key="AppBackground" Color="#14171F"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#191D27"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#14171F"/>
    <SolidColorBrush x:Key="ContentScrim" Color="#1E2330"/>
    <SolidColorBrush x:Key="Surface" Color="#252B38"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#252B38"/>
    <SolidColorBrush x:Key="AppText" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="MutedText" Color="#B6BDC9"/>
    <SolidColorBrush x:Key="CaptionText" Color="#ABB3C2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#465064"/>
    <SolidColorBrush x:Key="SubtleBorder" Color="#343D50"/>
    <SolidColorBrush x:Key="ControlHover" Color="#30384A"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#394258"/>
    <SolidColorBrush x:Key="SoftInputBackground" Color="#252B38"/>
    <SolidColorBrush x:Key="SoftFocusedInputBackground" Color="#2D3445"/>
    <SolidColorBrush x:Key="SoftDisabledBackground" Color="#1D222E"/>
    <SolidColorBrush x:Key="ErrorText" Color="#FFB3B8"/>
    <Color x:Key="SoftShadowColor">#04060B</Color>
    <Color x:Key="SoftPanelShadowColor">#04060B</Color>
    <DropShadowEffect x:Key="SoftPopupShadow" Color="#04060B" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.24"/>
</ResourceDictionary>
