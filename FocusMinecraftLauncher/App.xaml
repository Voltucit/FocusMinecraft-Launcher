<Application x:Class="FocusMinecraftLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ui:ThemesDictionary Theme="Light"/>
            <ui:ControlsDictionary/>
            <ResourceDictionary Source="Presentation/Resources/Controls.xaml"/>
            <ResourceDictionary Source="Presentation/Resources/Glass.xaml"/>
            <ResourceDictionary Source="Presentation/Resources/WindowChrome.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Application.Resources>
</Application>
