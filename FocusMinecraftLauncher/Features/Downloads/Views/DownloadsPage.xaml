<UserControl x:Class="FocusMinecraftLauncher.Features.Downloads.Views.DownloadsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:FocusMinecraftLauncher.Features.Downloads.Views"
 xmlns:vm="clr-namespace:FocusMinecraftLauncher.Features.Downloads.ViewModels" SizeChanged="ResizePage" Focusable="False">
    <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding Escape}"/></UserControl.InputBindings>
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DownloadResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <DataTemplate DataType="{x:Type vm:VanillaCatalogViewModel}"><local:VanillaCatalogPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommunityCatalogViewModel}"><local:CommunityResourcePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VanillaInstallViewModel}"><local:VanillaInstallPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourceDetailViewModel}"><local:ResourceDetailPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskHistoryViewModel}"><local:TaskHistoryPage/></DataTemplate>
    </ResourceDictionary></UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid Margin="24" IsEnabled="{Binding CanInteract}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="下载" Style="{StaticResource PageTitle}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><fluent:Button Content="任务" Command="{Binding ShowTasks}" Style="{StaticResource QuietButton}"/></StackPanel>
            </Grid>
            <ComboBox Grid.Row="1" ItemsSource="{Binding NavigationChoices}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" DisplayMemberPath="Title" AutomationProperties.Name="下载分类" Margin="0,0,0,16" Visibility="{Binding IsCompact, Converter={StaticResource BoolVisibility}}"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" Width="140" Margin="0,0,20,0" IsSynchronizedWithCurrentItem="False" Visibility="{Binding IsCompact, Converter={StaticResource NotVisibility}}" AutomationProperties.Name="下载二级导航">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Style.Triggers><DataTrigger Binding="{Binding IsHeading}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="0,20,0,8"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding ActivePage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding ShowPage, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Margin="16,24" Visibility="{Binding ShowState, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StateDescription}" Style="{StaticResource Muted}" Margin="0,12,0,0"/><fluent:Button Content="重新加载" Command="{Binding NormalState}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <!-- 同一内容区内的预览层，不创建新窗口，不提供执行下载按钮。 -->
        <Grid Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolVisibility}}" Background="#66000000">
            <Border Background="{DynamicResource PopupSurface}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource OutlineThickness}" Margin="16" MaxWidth="800" MaxHeight="650" Padding="24" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVisibility}}" IsVisibleChanged="OverlayVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Preview.Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel DataContext="{Binding Preview}"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22"/>
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding SelectInstance, Converter={StaticResource BoolVisibility}}"><TextBlock Text="目标实例" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Session.Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding HasInstances}" AutomationProperties.Name="下载目标实例"/><TextBlock Text="{Binding InstanceText}" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding DependencyStatus}" Margin="0,16,0,8" TextWrapping="Wrap"/><Expander Header="前置资源" IsExpanded="True" Visibility="{Binding HasDependencies, Converter={StaticResource BoolVisibility}}"><ItemsControl ItemsSource="{Binding Dependencies}" ItemTemplate="{StaticResource DependencyRow}"/></Expander></StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,20,0,0"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><fluent:Button Content="确认下载" Command="{Binding Preview.Confirm}" Style="{StaticResource PrimaryButton}" Margin="0,16,12,0"/><fluent:Button x:Name="ClosePreviewButton" Content="关闭" Command="{Binding CloseOverlay}" HorizontalAlignment="Right" Margin="0,16,0,0"/></StackPanel>
                </Grid>
            </Border>
            <Border Background="{DynamicResource PopupSurface}" CornerRadius="{DynamicResource CardCornerRadius}" Margin="16" Padding="20" MaxWidth="960" MaxHeight="680" Visibility="{Binding IsImageOpen, Converter={StaticResource BoolVisibility}}" IsVisibleChanged="OverlayVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="图片预览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><Image Grid.Row="1" Source="{Binding LargeImage}" Stretch="Uniform"/><fluent:Button x:Name="CloseImageButton" Grid.Row="2" Content="关闭图片" Command="{Binding CloseOverlay}" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
