<UserControl x:Class="FocusMinecraftLauncher.Features.Downloads.Views.DownloadNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root" Focusable="False" Visibility="Collapsed" MaxWidth="480"
             HorizontalAlignment="Right" VerticalAlignment="Top" Unloaded="StopNotification">
    <UserControl.RenderTransform><TranslateTransform x:Name="Slide"/></UserControl.RenderTransform>
    <fluent:InfoBar x:Name="NoticeBar" IsOpen="True" IsClosable="True" IsVisibleChanged="NoticeVisibilityChanged"
                    Title="{Binding Notification.Message, ElementName=Root}" Foreground="White"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notification.Message, ElementName=Root}">
        <fluent:InfoBar.Resources>
            <!-- Radix Green/Red 11 搭配白字；仅覆盖消息，不改变当前主题的其他控件。 -->
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#18794E"/>
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBorderBrush" Color="#18794E"/>
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#CE2C31"/>
            <SolidColorBrush x:Key="InfoBarErrorSeverityBorderBrush" Color="#CE2C31"/>
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFFFFF"/>
        </fluent:InfoBar.Resources>
        <fluent:Button Content="查看错误详情" Command="{Binding Notification.ShowDetails, ElementName=Root}"
                       Visibility="{Binding Notification.HasDetails, ElementName=Root, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"
                       Margin="0,8,0,0"/>
    </fluent:InfoBar>
</UserControl>
