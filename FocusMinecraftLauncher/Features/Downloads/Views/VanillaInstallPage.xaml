<UserControl x:Class="FocusMinecraftLauncher.Features.Downloads.Views.VanillaInstallPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:FocusMinecraftLauncher.Features.Downloads.Views" Focusable="False">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DownloadResources.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="ComponentExpander" TargetType="ui:AnimatedExpander" BasedOn="{StaticResource {x:Type ui:AnimatedExpander}}">
            <Style.Triggers><DataTrigger Binding="{Binding HasOptions}" Value="False">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:AnimatedExpander"><Border Padding="12"><ContentPresenter ContentSource="Header" Margin="20,0,0,0"/></Border></ControlTemplate></Setter.Value></Setter>
            </DataTrigger></Style.Triggers>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <fluent:Button Content="返回版本列表" Command="{Binding Back}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Game.Image}" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1"><WrapPanel Margin="0,0,0,8"><TextBlock Text="Minecraft" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock Text="{Binding Game.Number}" FontWeight="SemiBold"/><TextBlock Text="{Binding Game.Kind}" Foreground="{DynamicResource MutedText}" Margin="12,0,0,0"/></WrapPanel><TextBlock Text="安装名称" Style="{StaticResource FieldLabel}"/><fluent:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="安装名称"/><TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorMessage}" Margin="0,6,0,0"/></StackPanel>
            </Grid>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:ScrollRetention.Position="{Binding Scroll}" Padding="0,0,8,16">
            <StackPanel>
                <TextBlock Text="加载器与附加组件" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Components}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:AnimatedExpander Style="{StaticResource ComponentExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" IsEnabled="{Binding HasOptions}" AutomationProperties.Name="{Binding Name}">
                            <ui:AnimatedExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="不兼容"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </ui:AnimatedExpander.Header>
                            <ItemsControl ItemsSource="{Binding Choices}"><ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton Style="{StaticResource DownloadChoice}" IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding CanChoose}" Command="{Binding Choose}" ToolTip="{Binding Hint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Option.Version}">
                                    <StackPanel><TextBlock Text="{Binding Option.Version}" FontWeight="Medium"/><WrapPanel><TextBlock Text="{Binding Option.Date}" Style="{StaticResource DownloadMeta}"/><TextBlock Text="{Binding Option.Stability}" Style="{StaticResource DownloadMeta}"/></WrapPanel><TextBlock Text="{Binding Option.ForgeNote}" Style="{StaticResource DownloadMeta}" Visibility="{Binding Option.ForgeNote, Converter={StaticResource TextVisibility}}"/></StackPanel>
                                </RadioButton>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ui:AnimatedExpander>
                        <fluent:Button Grid.Column="1" Content="清除" Command="{Binding Clear}" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="8,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}"/>
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding CompatibilityError}" Style="{StaticResource ErrorMessage}" Margin="0,6,0,0"/><fluent:Button Content="开始下载" Command="{Binding StartDownload}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" MinWidth="140" HorizontalAlignment="Right" ToolTip="将当前安装组合加入下载列表"/></StackPanel>
        </Border>
    </Grid>
</UserControl>
