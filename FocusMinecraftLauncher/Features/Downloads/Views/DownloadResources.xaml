<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls">
    <Style x:Key="ResourceBody" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="ResourceTitle" TargetType="TextBlock" BasedOn="{StaticResource ResourceBody}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="ResourceDescription" TargetType="TextBlock" BasedOn="{StaticResource ResourceBody}"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="DownloadMeta" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource CaptionText}"/><Setter Property="Margin" Value="0,3,12,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CommunityFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource DownloadMeta}"><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="CommunityComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style x:Key="CommunityCombo" TargetType="ui:AnimatedComboBox" BasedOn="{StaticResource {x:Type ui:AnimatedComboBox}}">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="MinHeight" Value="48"/><Setter Property="Height" Value="48"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource CommunityComboItem}"/>
    </Style>
    <!-- 摘要、版本系列、文件分组与前置资源使用同一右侧箭头及整行点击区域。 -->
    <Style x:Key="CommunityDisclosureToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="12"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource AppText}"/>
                    <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4,4 8,0" Width="8" Height="4" Stretch="Uniform"
                          IsHitTestVisible="False" Stroke="{DynamicResource AppText}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CommunityExpander" TargetType="ui:AnimatedExpander" BasedOn="{StaticResource {x:Type ui:AnimatedExpander}}">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:AnimatedExpander">
            <StackPanel>
                <ToggleButton x:Name="PART_Header" Style="{StaticResource CommunityDisclosureToggle}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"/>
                <ui:RevealDecorator x:Name="PART_Reveal"><ContentPresenter ContentSource="Content" Margin="12,4,12,12" TextElement.Foreground="{DynamicResource AppText}"/></ui:RevealDecorator>
            </StackPanel>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 筛选标题在第二行，列表在其下全宽展开，类型与加载器控件不嵌入折叠按钮。 -->
    <Style x:Key="CommunityRevealOnly" TargetType="ui:AnimatedExpander" BasedOn="{StaticResource CommunityExpander}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:AnimatedExpander">
            <ui:RevealDecorator x:Name="PART_Reveal"><ContentPresenter ContentSource="Content" TextElement.Foreground="{DynamicResource AppText}"/></ui:RevealDecorator>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CommunityScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource MutedText}" Opacity="{DynamicResource ScrollThumbOpacity}" CornerRadius="{DynamicResource Radius3}" Margin="2,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="{DynamicResource ScrollThumbHoverOpacity}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="{DynamicResource ScrollThumbDragOpacity}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CommunityScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource CommunityScrollBar}" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DownloadChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"><Border x:Name="SelectedMark" Margin="4" CornerRadius="5" Background="{DynamicResource PrimaryBackground}" Visibility="Collapsed"/></Border>
                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="DependencyRow">
        <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="{DynamicResource ControlCornerRadius}" VerticalAlignment="Top" HorizontalAlignment="Left"><Border.Background><ImageBrush ImageSource="{Binding Project.Image}" Stretch="UniformToFill"/></Border.Background></Border>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Project.Name}" Style="{StaticResource ResourceBody}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Name}"/>
                    <WrapPanel><TextBlock Text="{Binding Kind}" Style="{StaticResource DownloadMeta}" FontWeight="SemiBold"/><TextBlock Text="{Binding Requirement}" Style="{StaticResource DownloadMeta}"/><TextBlock Text="{Binding Project.AuthorText}" Style="{StaticResource DownloadMeta}"/><TextBlock Text="{Binding Project.SourceText}" Style="{StaticResource DownloadMeta}"/></WrapPanel>
                    <TextBlock Text="{Binding Compatibility}" Style="{StaticResource DownloadMeta}"/>
                    <TextBlock Text="{Binding Dependency.Note}" Style="{StaticResource DownloadMeta}"/>
                </StackPanel>
                <fluent:Button Grid.Column="2" Content="查看" Command="{Binding Open}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="查看前置资源详情"/>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
