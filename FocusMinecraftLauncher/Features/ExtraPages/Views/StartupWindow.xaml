<Window x:Class="FocusMinecraftLauncher.Features.ExtraPages.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusMinecraftLauncher"
        Width="380" Height="184"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        UseLayoutRounding="True">
    <!-- Radix Gray 1 用于底色，Gray 12 用于高对比文字。 -->
    <Border x:Name="StartupSurface" Background="#FCFCFC" CornerRadius="16" Padding="24" Margin="0,12">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EntranceOffset"/>
        </Border.RenderTransform>
        <TextBlock x:Name="ProductName" Text="FocusMinecraftLauncher"
                   FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                   FontSize="24" FontWeight="SemiBold" Foreground="#202020"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
