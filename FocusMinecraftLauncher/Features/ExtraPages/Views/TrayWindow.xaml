<Window x:Class="FocusMinecraftLauncher.Features.ExtraPages.Views.TrayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
 Title="FMLauncher 精简面板" Width="380" Height="520" WindowStartupLocation="Manual"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="True" Topmost="False"
 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource AppText}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
 visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}" visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}"
 visual:ThemeVisuals.MotionAllowed="{Binding Session.MotionAllowed}"
 Activated="PanelActivated" Deactivated="PanelDeactivated" KeyDown="PanelKeyDown">
    <Border x:Name="Surface" Margin="12" Background="{DynamicResource PopupSurface}" CornerRadius="12" Padding="16">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="16" ShadowDepth="4"/></Border.Effect>
        <Border.RenderTransform><TranslateTransform x:Name="RevealOffset"/></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="{DynamicResource LauncherIcon}" Width="24" Height="24" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="FMLauncher" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding RuntimeStatus, Converter={StaticResource TextVisibility}}"/>
                </StackPanel>
                <visual:PlayerHead Grid.Column="2" Source="{Binding Session.CurrentAccount.HeadImage}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="当前玩家皮肤头像"/>
                <fluent:Button Grid.Column="3" Command="{Binding OpenSettings}" Style="{StaticResource QuietButton}" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="8" ToolTip="打开设置" AutomationProperties.Name="打开设置">
                    <Path Data="M3,5 H7 M11,5 H17 M3,15 H11 M15,15 H17 M7,2 V8 M11,12 V18" Stroke="{DynamicResource AppText}" StrokeThickness="1.5" Stretch="Uniform"/>
                </fluent:Button>
                <fluent:Button Grid.Column="4" Command="{Binding RestoreMainWindow}" Style="{StaticResource QuietButton}" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="8" ToolTip="还原完整启动器" AutomationProperties.Name="还原完整启动器">
                    <Path Data="M11,3 H17 V9 M17,3 L10,10 M9,17 H3 V11 M3,17 L10,10" Stroke="{DynamicResource AppText}" StrokeThickness="1.5" Stretch="Uniform"/>
                </fluent:Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <Border Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource Radius12}" Padding="12">
                        <Grid>
                            <Grid Visibility="{Binding HasCurrentGame, Converter={StaticResource BoolVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding CurrentGame.DisplayIcon}" Width="44" Height="44" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding CurrentGame.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentGame.Name}"/>
                                    <TextBlock Text="{Binding CurrentGame.VersionText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CurrentGame.ComponentsText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="尚未选择游戏" FontWeight="SemiBold" Margin="0,12" Visibility="{Binding HasCurrentGame, Converter={StaticResource NotVisibility}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSummaryTask, Converter={StaticResource BoolVisibility}}">
                        <DockPanel>
                            <fluent:Button DockPanel.Dock="Right" Content="查看任务" Command="{Binding OpenTasks}" Style="{StaticResource QuietButton}" MinHeight="26" Padding="6,2" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding SummaryTask.Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TaskDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskDetail}" AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar Value="{Binding SummaryTask.Percent, Mode=OneWay, FallbackValue=0}" IsIndeterminate="{Binding SummaryTask.IsIndeterminate, FallbackValue=False}" Height="4" Margin="0,8,0,0"
                                     Visibility="{Binding SummaryTask.ShowProgress, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" AutomationProperties.Name="当前任务进度"/>
                        <TextBlock Text="{Binding TransferText}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding TransferText, Converter={StaticResource TextVisibility}}"/>
                    </StackPanel>
                    <fluent:Button Content="{Binding FailureText}" Command="{Binding OpenTasks}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource ErrorText}" MinHeight="28" Padding="0,5" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="{Binding HasFailures, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding HasQuickGames, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding QuickGamesTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding QuickGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <fluent:Button Command="{Binding DataContext.ChooseGame, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,2" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding DisplayIcon}" Width="26" Height="26" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </fluent:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding LaunchHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding LaunchHint, Converter={StaticResource TextVisibility}}"/>
                <fluent:Button Content="{Binding LaunchText}" Command="{Binding LaunchGame}" Style="{StaticResource PrimaryButton}" Height="44" HorizontalAlignment="Stretch" AutomationProperties.Name="启动当前游戏"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
