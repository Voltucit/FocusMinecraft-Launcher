<UserControl x:Class="FocusMinecraftLauncher.Features.Multiplayer.Views.MultiplayerRoomPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
 Focusable="False" Foreground="{DynamicResource AppText}">
    <UserControl.Resources>
        <Style x:Key="ConnectionStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <Border Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource ConnectionStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding ConnectionError}" Style="{StaticResource ErrorMessage}" Margin="0,8,0,0"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="连接中状态"/>
                    </StackPanel>
                    <fluent:Button Grid.Column="1" Content="重试" Command="{Binding Retry}" VerticalAlignment="Center"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolVisibility}}"/>
                    <fluent:Button Grid.Column="1" Content="取消连接" Command="{Binding CancelConnection}" VerticalAlignment="Center"
                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </Border>
            <StackPanel Visibility="{Binding IsHosting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,24">
                <TextBlock Text="邀请信息" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding RoomInvitation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0" AutomationProperties.Name="房间邀请信息"/>
                    <fluent:Button Grid.Column="1" Content="复制邀请信息" Command="{Binding CopyInvitation}" AutomationProperties.Name="复制房间邀请信息"/>
                </Grid>
            </StackPanel>
            <TextBlock Text="{Binding MemberHeading}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Members}" AutomationProperties.Name="房间成员">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <visual:PlayerHead Source="{Binding Avatar}" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="玩家头像"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding IpText}" Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding ConnectionText}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Role}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <fluent:Button Grid.Column="3" Content="复制 IP" Style="{StaticResource QuietButton}"
                                    Command="{Binding DataContext.CopyMemberIp, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="复制此成员的虚拟 IP" ToolTip="复制此成员的虚拟 IP" ToolTipService.ShowOnDisabled="True"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <visual:AnimatedExpander Header="连接信息" Margin="0,20,0,0" AutomationProperties.Name="连接信息">
                <Grid Margin="12,8,12,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="连接方式" Style="{StaticResource Muted}" Margin="0,0,12,12"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionKind}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="延迟" Style="{StaticResource Muted}" Margin="0,0,12,12"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionLatency}" Margin="0,0,0,12"/>
                </Grid>
            </visual:AnimatedExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
