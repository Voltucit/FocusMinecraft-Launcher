<UserControl x:Class="FocusMinecraftLauncher.Features.Home.Views.MinimalHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
             xmlns:home="clr-namespace:FocusMinecraftLauncher.Features.Home.Views" Focusable="False">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding WelcomeText}" Style="{StaticResource PageTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding WelcomeText}" Margin="0,0,0,24"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="AvatarButton" Style="{StaticResource AvatarAction}" Click="OpenAccountActions"
                    VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="皮肤披风、账号资料、账号切换"
                    AutomationProperties.Name="玩家头像与账号操作">
                <ui:PlayerHead Width="{Binding SimpleAvatarSize}" Height="{Binding SimpleAvatarSize}" Source="{Binding Session.CurrentAccount.HeadImage}"/>
            </Button>
            <!-- 留白布局：动作行留在头像右侧滑出，展开时只占用右侧空隙，不挤压头像。 -->
            <home:AccountActionsView x:Name="MinimalActions" Mode="Horizontal" Grid.Column="1"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <home:HomeLaunchPanel Grid.Column="2" Width="{Binding LaunchPanelWidth}" FeedbackMaxHeight="{Binding CenteredFeedbackHeight}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
