<UserControl x:Class="FocusMinecraftLauncher.Features.Home.Views.CenteredHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
             xmlns:home="clr-namespace:FocusMinecraftLauncher.Features.Home.Views" Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
    <Grid Margin="32">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:PlayerHead Width="{Binding AvatarSize}" Height="{Binding AvatarSize}" Source="{Binding Session.CurrentAccount.HeadImage}"
                           HorizontalAlignment="Center" ToolTip="{Binding PlayerName}" AutomationProperties.Name="当前玩家头像"/>
            <TextBlock Text="{Binding WelcomeText}" Style="{StaticResource PageTitle}" TextAlignment="Center" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding WelcomeText}" Margin="0,16,0,24"/>
            <home:HomeLaunchPanel FeedbackMaxHeight="{Binding CenteredFeedbackHeight}"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
