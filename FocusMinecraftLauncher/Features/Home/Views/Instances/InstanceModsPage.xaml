<UserControl x:Class="FocusMinecraftLauncher.Features.Home.Views.Instances.InstanceModsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
 xmlns:views="clr-namespace:FocusMinecraftLauncher.Features.Home.Views.Instances"
 xmlns:models="clr-namespace:FocusMinecraftLauncher.Features.Home.Models" Focusable="False">


<Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <fluent:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="搜索名称、描述、文件名或标签" AutomationProperties.Name="搜索当前游戏的 Mod" IsEnabled="{Binding SupportsMods}"/>
    <WrapPanel Grid.Row="1" Margin="0,12,0,0"><fluent:Button Content="重新读取" Command="{Binding Reload}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
        <fluent:Button Content="打开 Mod 文件夹" Command="{Binding OpenFolder}" Margin="0,0,8,8"/>
        <fluent:Button Content="从文件安装" Command="{Binding InstallFiles}" Margin="0,0,8,8"/>
        <fluent:Button Content="下载新 Mod" Command="{Binding DownloadMods}" Margin="0,0,8,8"/>
        <CheckBox Content="全选" IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}" IsEnabled="{Binding ShowList}" Margin="0,0,0,8"/>
    </WrapPanel>
    <StackPanel Grid.Row="2" Margin="0,8,0,16">
        <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" AutomationProperties.Name="读取 Mod 列表"/>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Notice, Converter={StaticResource TextVisibility}}"/>
    </StackPanel>
    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredItems}" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="当前游戏 Mod 列表">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="4,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource Radius8}" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid><Path Data="M2,6 L10,2 18,6 18,15 10,19 2,15 Z M2,6 L10,10 18,6 M10,10 V19" Stroke="{DynamicResource MutedText}" StrokeThickness="1.3" Width="20" Height="21"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid></Border>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding FileName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowFileName, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/><WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="0,0,12,0"/><TextBlock Text="{Binding Loader}" Style="{StaticResource Caption}"/></WrapPanel></StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="4" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12,0,0"><fluent:Button Content="启用" Command="{Binding EnableSelected}" Margin="0,0,8,8"/><fluent:Button Content="禁用" Command="{Binding DisableSelected}" Margin="0,0,8,8"/><fluent:Button Content="删除" Command="{Binding RequestRemove}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><fluent:Button Content="取消选择" Command="{Binding ClearSelection}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
            <StackPanel Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,8"><TextBlock Text="所选 Mod 文件将移入回收站，不会删除存档。" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><fluent:Button Content="确认移除" Command="{Binding RemoveSelected}" Foreground="{DynamicResource ErrorText}" Margin="0,0,8,8"/><fluent:Button Content="保留" Command="{Binding CancelRemove}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
        </StackPanel>
    </Border>
</Grid>

</UserControl>
