<UserControl x:Class="FocusMinecraftLauncher.Features.Home.Views.Instances.InstanceSavesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls" Focusable="False">


<Grid Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <fluent:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="搜索存档名称" AutomationProperties.Name="搜索存档"/>
    <StackPanel Grid.Row="1" Margin="0,12,0,16">
        <WrapPanel><fluent:Button Content="重新读取" Command="{Binding Reload}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/><fluent:Button Content="打开存档文件夹" Command="{Binding OpenFolder}" Margin="0,0,8,8"/><CheckBox Content="全选" IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" AutomationProperties.Name="读取存档列表"/>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Notice, Converter={StaticResource TextVisibility}}"/>
    </StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredItems}" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="存档列表" MouseDoubleClick="ListDoubleClick">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="4,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                    <!-- 图片就是存档自己的 icon.png，进入游戏后拍的那张，与实际存档一致。 -->
                    <Border Grid.Column="1" Width="56" Height="56" Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource Radius8}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid><Path Data="M2,6 L10,2 18,6 18,15 10,19 2,15 Z M2,6 L10,10 18,6 M10,10 V19" Stroke="{DynamicResource MutedText}" StrokeThickness="1.3" Width="20" Height="21" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVisibility}}"/><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="3" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12,0,0"><fluent:Button Content="删除" Command="{Binding RequestRemove}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><fluent:Button Content="取消选择" Command="{Binding ClearSelection}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
            <StackPanel Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,8"><TextBlock Text="所选存档会移入回收站，世界数据随之删除。" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><fluent:Button Content="确认删除" Command="{Binding RemoveSelected}" Foreground="{DynamicResource ErrorText}" Margin="0,0,8,8"/><fluent:Button Content="保留" Command="{Binding CancelRemove}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
        </StackPanel>
    </Border>
</Grid>

</UserControl>
