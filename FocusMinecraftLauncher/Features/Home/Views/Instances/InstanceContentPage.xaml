<UserControl x:Class="FocusMinecraftLauncher.Features.Home.Views.Instances.InstanceContentPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
 xmlns:views="clr-namespace:FocusMinecraftLauncher.Features.Home.Views.Instances"
 xmlns:models="clr-namespace:FocusMinecraftLauncher.Features.Home.Models" Focusable="False">


<UserControl.Resources>
    <Style x:Key="ContentNameLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Trigger>
        </Style.Triggers>
    </Style>
</UserControl.Resources>
<Grid Background="Transparent" AllowDrop="True" DragOver="PageDragOver" DragLeave="PageDragLeave" Drop="PageDrop">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <fluent:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="搜索名称、描述或文件名" AutomationProperties.Name="搜索当前游戏的内容" IsEnabled="{Binding SupportsKind}"/>
    <WrapPanel Grid.Row="1" Margin="0,12,0,0"><fluent:Button Content="重新读取" Command="{Binding Reload}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
        <fluent:Button Content="打开文件夹" Command="{Binding OpenFolder}" Margin="0,0,8,8"/>
        <fluent:Button Content="从文件安装" Command="{Binding InstallFiles}" Margin="0,0,8,8"/>
        <fluent:Button Content="下载新 Mod" Command="{Binding DownloadMods}" Visibility="{Binding CanDownload, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/>
        <fluent:Button Content="检查更新" Command="{Binding CheckUpdates}" Margin="0,0,8,8"/>
        <fluent:Button Content="更新所选" Command="{Binding UpdateSelected}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
        <CheckBox Content="全选" IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}" IsEnabled="{Binding ShowList}" Margin="0,0,0,8"/>
    </WrapPanel>
    <StackPanel Grid.Row="2" Margin="0,8,0,16">
        <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" AutomationProperties.Name="读取内容列表"/>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Notice, Converter={StaticResource TextVisibility}}"/>
        <TextBlock Text="{Binding UpdateSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding UpdateSummary, Converter={StaticResource TextVisibility}}"/>
        <TextBlock Text="{Binding DropNotice}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding DropNotice, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredItems}" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="当前游戏的内容列表">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="4,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource Radius8}" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid><Path Data="M2,6 L10,2 18,6 18,15 10,19 2,15 Z M2,6 L10,10 18,6 M10,10 V19" Stroke="{DynamicResource MutedText}" StrokeThickness="1.3" Width="20" Height="21"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid></Border>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Visibility="{Binding CanOpenDetails, Converter={StaticResource NotVisibility}}"/>
                        <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Visibility="{Binding CanOpenDetails, Converter={StaticResource BoolVisibility}}">
                            <Hyperlink Style="{StaticResource ContentNameLink}" Command="{Binding DataContext.OpenModDetails, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="在下载页查看资源详情"><Run Text="{Binding Name, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowFileName, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/><WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="0,0,12,0" Visibility="{Binding Version, Converter={StaticResource TextVisibility}}"/><TextBlock Text="{Binding Loader}" Style="{StaticResource Caption}" Visibility="{Binding Loader, Converter={StaticResource TextVisibility}}"/></WrapPanel><TextBlock Text="{Binding UpdateText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding UpdateText, Converter={StaticResource TextVisibility}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="4" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12,0,0"><fluent:Button Content="启用" Command="{Binding EnableSelected}" Visibility="{Binding SupportsToggle, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><fluent:Button Content="禁用" Command="{Binding DisableSelected}" Visibility="{Binding SupportsToggle, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><fluent:Button Content="删除" Command="{Binding RequestRemove}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><fluent:Button Content="取消选择" Command="{Binding ClearSelection}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
            <StackPanel Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,8"><TextBlock Text="所选文件将移入回收站，不会影响存档。" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><fluent:Button Content="确认移除" Command="{Binding RemoveSelected}" Foreground="{DynamicResource ErrorText}" Margin="0,0,8,8"/><fluent:Button Content="保留" Command="{Binding CancelRemove}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
        </StackPanel>
    </Border>
    <Border x:Name="DropHint" Grid.RowSpan="5" Background="{DynamicResource ControlHover}" BorderBrush="{DynamicResource PrimaryBackground}" BorderThickness="2" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="松开以安装" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DropHintText" Text="支持 .jar 文件" Style="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Grid>

</UserControl>
