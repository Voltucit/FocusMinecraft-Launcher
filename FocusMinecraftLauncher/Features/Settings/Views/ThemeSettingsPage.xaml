<UserControl x:Class="FocusMinecraftLauncher.Features.Settings.Views.ThemeSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
             xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FocusMinecraftLauncher.Features.Settings.Views" Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,24">
        <Border Style="{StaticResource GlassCard}" VerticalAlignment="Top">
            <StackPanel>
                <ui:AnimatedExpander IsExpanded="{Binding IsThemeSettingsExpanded, Mode=TwoWay}" AutomationProperties.Name="界面主题">
                    <ui:AnimatedExpander.Header>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="界面主题" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Session.Theme}" Foreground="{DynamicResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:AnimatedExpander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <ui:SettingRow Title="主题">
                            <ui:AnimatedComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Session.Theme, Mode=TwoWay}" AutomationProperties.Name="界面主题"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="背景图片">
                            <StackPanel>
                                <TextBlock Text="{Binding Session.BackgroundImageName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.BackgroundImageName}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <fluent:Button Content="{Binding BackgroundActionText}" Command="{Binding BrowseBackground}" Margin="0,0,8,0" AutomationProperties.Name="选择当前主题背景图片"/>
                                    <fluent:Button Content="恢复默认" Command="{Binding ResetBackground}" Style="{StaticResource QuietButton}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Session.BackgroundError}" Style="{StaticResource ErrorMessage}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:SettingRow>
                        <ui:AnimatedExpander IsExpanded="{Binding IsWallpaperExpanded, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Wallpaper Engine 壁纸">
                            <ui:AnimatedExpander.Header>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Wallpaper Engine 壁纸" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WallpaperListStatus}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </ui:AnimatedExpander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="从本地项目中读取；需要已安装 Wallpaper Engine" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding WallpaperRows}" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" Focusable="False"
                                         PreviewMouseWheel="WallpaperList_OnPreviewMouseWheel"
                                         AutomationProperties.Name="本地 Wallpaper Engine 壁纸">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template"><Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                            </Setter.Value></Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Command="{Binding DataContext.SelectWallpaper, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" FocusVisualStyle="{x:Null}" Padding="0"
                                                        BorderThickness="0" Background="Transparent" Margin="0,0,8,0"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                    <Button.Template><ControlTemplate TargetType="Button">
                                                        <Border x:Name="Card" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource Surface}"
                                                                BorderBrush="Transparent" BorderThickness="2" ClipToBounds="True">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate></Button.Template>
                                                    <Grid Height="132">
                                                        <TextBlock Text="无预览" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Style="{StaticResource Caption}" Opacity="0.45"/>
                                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="10,7">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding KindText}" Foreground="#CCFFFFFF" FontSize="12" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <fluent:Button Content="加载更多" Command="{Binding LoadMoreWallpapers}" Style="{StaticResource QuietButton}"
                                               HorizontalAlignment="Center" Margin="0,8,0,8"
                                               Visibility="{Binding HasMoreWallpapers, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding Session.WallpaperName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.WallpaperName}" Margin="0,4,0,8"/>
                                <ui:AnimatedExpander IsExpanded="{Binding IsWallpaperPropertiesExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                                     Visibility="{Binding HasWallpaperProperties, Converter={StaticResource BoolVisibility}}"
                                                     AutomationProperties.Name="壁纸设置">
                                    <ui:AnimatedExpander.Header>
                                        <TextBlock Text="壁纸设置" FontWeight="SemiBold" FontSize="13"/>
                                    </ui:AnimatedExpander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <fluent:Button Content="恢复默认值" Command="{Binding ResetWallpaperProperties}"
                                                       Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                                        <local:WallpaperPropertiesEditor ItemsSource="{Binding WallpaperProperties}"/>
                                    </StackPanel>
                                </ui:AnimatedExpander>
                                <WrapPanel>
                                    <fluent:Button Content="刷新列表" Command="{Binding RefreshWallpaperList}" Margin="0,0,8,8"/>
                                    <fluent:Button Content="恢复默认" Command="{Binding ClearWallpaper}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Session.WallpaperError}" Style="{StaticResource ErrorMessage}"/>
                            </StackPanel>
                        </ui:AnimatedExpander>
                            <ui:SettingRow Title="模糊度" Description="{Binding Session.BackgroundBlurHint}" IsEnabled="{Binding Session.CanAdjustBackgroundBlur}"
                                           ToolTip="调整自定义背景图片的模糊程度" ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" MinHeight="32"
                                            Value="{Binding Session.BackgroundBlur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="背景模糊度"
                                            AutomationProperties.HelpText="0 为清晰，100 为最模糊；只影响背景图片"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Session.BackgroundBlur, StringFormat={}{0:0}%}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:SettingRow>
                            <ui:SettingRow Title="动态模糊" Description="{Binding Session.DynamicBlurHint}" IsEnabled="{Binding Session.ShowCustomBackgroundImage}"
                                           Visibility="{Binding Session.IsBlurTheme, Converter={StaticResource BoolVisibility}}"
                                           ToolTip="选择背景图片后，模糊强度围绕滑块值缓慢变化" ToolTipService.ShowOnDisabled="True">
                                <CheckBox Content="启用动态模糊" IsChecked="{Binding Session.DynamicBlurEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="启用背景动态模糊"/>
                            </ui:SettingRow>
                        <ui:SettingRow Title="配色预设" Visibility="{Binding Session.IsFlatTheme, Converter={StaticResource BoolVisibility}}">
                            <ui:AnimatedComboBox ItemsSource="{Binding FlatColorPresets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                 SelectedValue="{Binding Session.FlatColorPresetId, Mode=TwoWay}"
                                                 AutomationProperties.Name="极简主题配色预设"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="夜间模式" Visibility="{Binding Session.IsFlatTheme, Converter={StaticResource BoolVisibility}}">
                            <fluent:ToggleSwitch IsChecked="{Binding Session.FlatNightMode, Mode=TwoWay}" OnContent="已开启" OffContent="已关闭"
                                                 HorizontalAlignment="Left" Foreground="{DynamicResource AppText}"
                                                 FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="极简主题夜间模式"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="配色预设" Visibility="{Binding Session.IsSoftTheme, Converter={StaticResource BoolVisibility}}">
                            <ui:AnimatedComboBox ItemsSource="{Binding SoftColorPresets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                 SelectedValue="{Binding Session.SoftColorPresetId, Mode=TwoWay}"
                                                 AutomationProperties.Name="柔和主题配色预设"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="夜间模式" Visibility="{Binding Session.IsSoftTheme, Converter={StaticResource BoolVisibility}}">
                            <fluent:ToggleSwitch IsChecked="{Binding Session.SoftNightMode, Mode=TwoWay}" OnContent="已开启" OffContent="已关闭"
                                                 HorizontalAlignment="Left" Foreground="{DynamicResource AppText}"
                                                 FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="柔和主题夜间模式"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="界面动画" Description="遵循 Windows 动画偏好">
                            <CheckBox Content="启用动画" IsChecked="{Binding Session.AnimationsEnabled, Mode=TwoWay}" AutomationProperties.Name="启用界面动画"/>
                        </ui:SettingRow>
                    </StackPanel>
                </ui:AnimatedExpander>
                <ui:AnimatedExpander Margin="0,16,0,0" IsExpanded="{Binding IsHomeLayoutsExpanded, Mode=TwoWay}" AutomationProperties.Name="主页布局">
                    <ui:AnimatedExpander.Header>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="主页布局" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Session.HomeLayoutName}" Foreground="{DynamicResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:AnimatedExpander.Header>
                    <StackPanel>
                        <local:HomeLayoutSelector Margin="0,12,-12,12"/>
                        <ui:SettingRow Title="主页内容" Description="仅经典布局显示">
                            <WrapPanel>
                                <CheckBox Content="启动器更新记录" IsChecked="{Binding Session.ShowLauncherUpdates, Mode=TwoWay}" AutomationProperties.Name="显示启动器更新记录" Margin="0,0,24,0"/>
                                <CheckBox Content="游戏更新记录" IsChecked="{Binding Session.ShowGameUpdates, Mode=TwoWay}" AutomationProperties.Name="显示游戏更新记录"/>
                            </WrapPanel>
                        </ui:SettingRow>
                    </StackPanel>
                </ui:AnimatedExpander>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
