<UserControl x:Class="FocusMinecraftLauncher.Features.Settings.Views.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:FocusMinecraftLauncher.Features.Settings.Views"
 xmlns:ui="clr-namespace:FocusMinecraftLauncher.Presentation.Controls" SizeChanged="ResizePage" Focusable="False">
 
 
<Grid Margin="32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" AutomationProperties.Name="设置分类">
        <TabItem Header="常规">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,24">
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="游戏" Style="{StaticResource SectionTitle}"/>
        <ui:SettingRow Title="Java 路径">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <fluent:TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" Tag="自动选择"
                                    ToolTip="{Binding JavaDisplayText}" AutomationProperties.Name="全局 Java 路径，留空自动选择"/>
                    <fluent:Button Grid.Column="1" Content="浏览" Command="{Binding BrowseJava}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding JavaError}" Style="{StaticResource ErrorMessage}" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,8,0,0">
                    <fluent:Button Content="检测本机 Java" Command="{Binding JavaDetection.Detect}" Margin="0,0,8,0"/>
                    <fluent:Button Content="恢复自动选择" Command="{Binding ClearJava}" Style="{StaticResource QuietButton}"
                                   Visibility="{Binding IsJavaAutoSelected, Converter={StaticResource NotVisibility}}"/>
                </WrapPanel>
                <StackPanel DataContext="{Binding JavaDetection}" Margin="0,12,0,0">
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                 Margin="0,0,0,8" AutomationProperties.Name="Java 检测状态"/>
                    <TextBlock Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers><DataTrigger Binding="{Binding HasFailed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Results}" Visibility="{Binding HasResults, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <WrapPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding Distribution}"/></WrapPanel>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Architecture}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="当前选择" Foreground="{DynamicResource AccentText}" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"/>
                                        <fluent:Button Content="选择" Command="{Binding DataContext.Select, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" Visibility="{Binding IsSelected, Converter={StaticResource NotVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ui:SettingRow>
        <ui:SettingRow Title="内存分配"><ui:MemoryAllocationPanel DataContext="{Binding MemoryAllocation}"/></ui:SettingRow>
        <ui:SettingRow Title="游戏目录">
            <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><fluent:TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏根目录" ToolTip="{Binding GameDirectory}"/><fluent:Button Grid.Column="1" Content="浏览" Command="{Binding BrowseDirectory}" Margin="8,0,0,0"/></Grid><TextBlock Text="{Binding DirectoryError}" Style="{StaticResource ErrorMessage}" Margin="0,8,0,0"/></StackPanel>
        </ui:SettingRow>
        <Expander Header="高级启动选项" Margin="0,8,0,0"><ui:SettingRow Title="JVM 参数"><fluent:TextBox Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="附加 JVM 参数" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top"/></ui:SettingRow></Expander>
        <WrapPanel Margin="0,16,0,0"><fluent:Button Content="保存游戏设置" Command="{Binding Save}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"/><fluent:Button Content="恢复已保存的值" Command="{Binding Restore}" Margin="0,0,0,12"/></WrapPanel>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Notice, Converter={StaticResource TextVisibility}}"/>
        <TextBlock Text="游戏设置保存后生效。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
    </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="主题"><views:ThemeSettingsPage/></TabItem>
        <TabItem Header="其他"><views:OtherSettingsPage DataContext="{Binding Other}"/></TabItem>
    </TabControl>
</Grid>

</UserControl>
