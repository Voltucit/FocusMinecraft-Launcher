<ui:FluentWindow x:Class="FocusMinecraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visual="clr-namespace:FocusMinecraftLauncher.Presentation.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:downloads="clr-namespace:FocusMinecraftLauncher.Features.Downloads.Views"
        Title="FMLauncher" Width="1440" Height="900" MinWidth="960" MinHeight="640"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" AllowDrop="True" PreviewDragOver="WindowDragOver" PreviewDrop="WindowDrop"
        visual:ThemeVisuals.IsSoft="{DynamicResource SoftEnabled}"
        visual:ThemeVisuals.IsFlat="{DynamicResource FlatEnabled}"
        visual:ThemeVisuals.MotionAllowed="{Binding Session.MotionAllowed}">
    <Window.Resources>
        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusFrame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="{DynamicResource NavigationFocusCornerRadius}">
                            <Grid>
                                <Border x:Name="Hover" Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource NavigationCornerRadius}" Opacity="0"/>
                                <Border x:Name="Pressed" Background="{DynamicResource ControlPressed}" CornerRadius="{DynamicResource NavigationCornerRadius}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pressed" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NavigationEntry" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FocusFrame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="{DynamicResource NavigationFocusCornerRadius}">
                            <Grid>
                                <Border x:Name="Hover" Background="{DynamicResource ControlHover}" CornerRadius="{DynamicResource NavigationCornerRadius}" Opacity="0"/>
                                <Border x:Name="Selected" Background="{DynamicResource NavigationSelectedBackground}" CornerRadius="{DynamicResource NavigationCornerRadius}" Opacity="0"/>
                                <ContentPresenter x:Name="NavigationContent" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="NavigationContent" Property="Margin" Value="0"/>
                                <Setter TargetName="NavigationContent" Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavigationSelectedText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowSurface" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ExitScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        
        <visual:BlurImageBackground Grid.RowSpan="3" BlurRadius="{Binding Session.BackgroundBlurRadius}"
                                    IsDynamicBlurEnabled="{Binding Session.DynamicBlurEnabled}" MotionAllowed="{Binding Session.MotionAllowed}"/>
        <visual:WallpaperBackground Grid.RowSpan="3" Kind="{Binding Session.WallpaperKind}"
                                    SourcePath="{Binding Session.WallpaperPath}" PreviewPath="{Binding Session.WallpaperPreviewPath}"
                                    ProjectPath="{Binding Session.WallpaperProject}" PropertiesJson="{Binding Session.WallpaperPropertiesJson}"
                                    RefreshVersion="{Binding Session.WallpaperRefreshVersion}" MotionAllowed="{Binding Session.MotionAllowed}"
                                    RenderStateChanged="Wallpaper_OnRenderStateChanged" BlurPercent="{Binding Session.BackgroundBlur}"
                                    Visibility="{Binding Session.HasWallpaper, Converter={StaticResource BoolVisibility}}"/>
        
        <ui:TitleBar x:Name="AppTitleBar" Title="FMLauncher" Height="40" Padding="16,0,12,0"
                     Background="{DynamicResource TitleBarBackground}" Foreground="{DynamicResource AppText}"
                     ButtonsForeground="{DynamicResource AppText}" ButtonsBackground="{DynamicResource ControlHover}"
                     ShowMaximize="False" CanMaximize="False"
                     CloseWindowByDoubleClickOnIcon="True" ForceShutdown="False"
                     KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="窗口标题栏">
            <ui:TitleBar.Icon><ui:ImageIcon Width="16" Height="16" Source="{DynamicResource LauncherIcon}"/></ui:TitleBar.Icon>
            <ui:TitleBar.Resources>
                <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource CaptionButton}"/>
            </ui:TitleBar.Resources>
        </ui:TitleBar>
        <ui:InfoBar Grid.Row="1" Severity="Warning" IsClosable="False" Margin="16,0,16,8"
                    IsOpen="{Binding Session.HasConfigurationMessage, Mode=OneWay}"
                    Visibility="{Binding Session.HasConfigurationMessage, Converter={StaticResource BoolVisibility}}"
                    Message="{Binding Session.ConfigurationMessage}" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <visual:GlassPanel x:Name="Sidebar" Width="236" MinWidth="72" MaxWidth="236"
                Background="{DynamicResource SidebarBackground}" CornerRadius="{DynamicResource SidebarCornerRadius}" BorderBrush="{DynamicResource SubtleBorder}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="8,8,8,12">
                    <Button x:Name="MenuToggle" Style="{StaticResource MenuButton}" Click="ToggleSidebar"
                            ToolTip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}">
                        <Path Data="M4,5 H16 M4,10 H16 M4,15 H16" Style="{StaticResource NavigationIcon}"/>
                    </Button>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationEntry}" BorderThickness="0" Background="Transparent"
                         Margin="12,0,12,16" Padding="0" Foreground="{DynamicResource AppText}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch" AutomationProperties.Name="页面导航">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{Binding IconData}" Style="{StaticResource NavigationIcon}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" Style="{StaticResource NavigationLabel}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </visual:GlassPanel>
        <visual:GlassPanel x:Name="InformationPanel" Grid.Column="1"
                           Background="{DynamicResource ContentScrim}" CornerRadius="{DynamicResource MainPanelCornerRadius}" Margin="16,12,16,16" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="{DynamicResource OutlineThickness}" HoverFeedback="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl x:Name="PageContent" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding SelectedItem.Title}"/>
            <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="32,12" Visibility="{Binding Session.ActiveTask.IsActive, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Session.ActiveTask.Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Session.ActiveTask.Stage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.ActiveTask.Stage}" AutomationProperties.LiveSetting="Polite"/><ProgressBar Value="{Binding Session.ActiveTask.Percent, Mode=OneWay}" IsIndeterminate="{Binding Session.ActiveTask.IsIndeterminate, Mode=OneWay}" Margin="0,8,0,0" Visibility="{Binding Session.ActiveTask.ShowProgress, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" AutomationProperties.Name="全局任务进度"/></StackPanel>
                    <ui:Button Grid.Column="1" Content="查看任务" Command="{Binding Session.OpenTasks}" Style="{StaticResource QuietButton}"/>
                </Grid>
            </Border>
        </Grid>
        </visual:GlassPanel>
        </Grid>
        <downloads:DownloadNotificationView Grid.RowSpan="3" Notification="{Binding Session.GlobalNotification}" Margin="24,64,24,0" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
