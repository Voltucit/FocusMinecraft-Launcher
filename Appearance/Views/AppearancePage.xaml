<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Appearance.Views.AppearancePage">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
        <TabControl>
            <TabItem Header="主题与布局">
                <DockPanel Margin="0,16,0,0">
                    <WrapPanel DockPanel.Dock="Bottom">
                        <ui:Button Content="预览" Command="{Binding Preview}" Margin="0,0,8,8" Padding="14,8"/>
                        <ui:Button Content="保存主题" Command="{Binding Save}" Appearance="Primary" Margin="0,0,8,8" Padding="14,8"/>
                        <ui:Button Content="恢复已保存主题" Command="{Binding Revert}" Margin="0,0,8,8" Padding="14,8"/>
                        <ui:Button Content="默认主题预览" Command="{Binding Reset}" Margin="0,0,8,8" Padding="14,8"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="外观预设" Style="{StaticResource Subheading}"/>
                                        <ComboBox SelectedValue="{Binding Preset}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Fluent 标准" Tag="Fluent"/>
                                            <ComboBoxItem Content="游戏沉浸" Tag="Immersive"/>
                                            <ComboBoxItem Content="二次元个性化" Tag="Anime"/>
                                            <ComboBoxItem Content="极简轻量" Tag="Minimal"/>
                                        </ComboBox>
                                        <WrapPanel>
                                            <ui:Button Content="应用预设预览" Command="{Binding ApplyPreset}" Margin="0,0,8,8" Padding="14,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="颜色模式" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding Draft.Mode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                                            <ComboBoxItem Content="浅色" Tag="Light"/>
                                            <ComboBoxItem Content="深色" Tag="Dark"/>
                                        </ComboBox>
                                        <TextBlock Text="强调色 #RRGGBB" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Draft.Accent, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="自定义底色 #RRGGBB（留空随主题）" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Draft.Background, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="属于你的 FMLauncher" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock Text="调整后点击预览，在实际窗口中查看颜色、圆角与材质。满意后再保存。" Style="{StaticResource MutedText}"/>
                                        <Border Style="{StaticResource Tag}" HorizontalAlignment="Left">
                                            <TextBlock Text="FOCUS / YOUR SPACE" Foreground="{DynamicResource Accent}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="布局与材质" Style="{StaticResource Subheading}"/>
                                        <TextBlock Text="窗口材质" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding Draft.Material}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="无材质" Tag="None"/>
                                            <ComboBoxItem Content="Mica 云母" Tag="Mica"/>
                                            <ComboBoxItem Content="Acrylic 亚克力" Tag="Acrylic"/>
                                        </ComboBox>
                                        <TextBlock Text="界面密度" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding Draft.Layout}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="舒展" Tag="Spacious"/>
                                            <ComboBoxItem Content="紧凑" Tag="Compact"/>
                                        </ComboBox>
                                        <TextBlock Text="卡片透明度" Style="{StaticResource FieldLabel}"/>
                                        <Slider Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.CardOpacity, Mode=TwoWay}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" Margin="0,4,0,16" AutomationProperties.Name="卡片透明度"/>
                                        <TextBlock Text="壁纸透明度" Style="{StaticResource FieldLabel}"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Draft.WallpaperOpacity, Mode=TwoWay}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" Margin="0,4,0,16" AutomationProperties.Name="壁纸透明度"/>
                                        <TextBlock Text="圆角大小" Style="{StaticResource FieldLabel}"/>
                                        <Slider Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Radius, Mode=TwoWay}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" Margin="0,4,0,16" AutomationProperties.Name="圆角大小"/>
                                        <TextBlock Text="背景模糊" Style="{StaticResource FieldLabel}"/>
                                        <Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Draft.Blur, Mode=TwoWay}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" Margin="0,4,0,16" AutomationProperties.Name="背景模糊"/>
                                        <CheckBox Content="页面滑动与柔和动画" IsChecked="{Binding Draft.Animations}"/>
                                        <CheckBox Content="从壁纸提取主题色" IsChecked="{Binding Draft.ExtractAccent}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="壁纸与 API">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="壁纸来源" Style="{StaticResource Subheading}"/>
                                <ComboBox SelectedValue="{Binding Wallpaper.Source}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="关闭壁纸" Tag="None"/>
                                    <ComboBoxItem Content="本地图片" Tag="Local"/>
                                    <ComboBoxItem Content="本地文件夹轮播" Tag="Folder"/>
                                    <ComboBoxItem Content="直接图片 API" Tag="DirectApi"/>
                                    <ComboBoxItem Content="JSON 图片 API" Tag="JsonApi"/>
                                </ComboBox>
                                <TextBlock Text="图片或文件夹路径" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Wallpaper.LocalPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel>
                                    <ui:Button Content="选择图片" Command="{Binding BrowseImage}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="选择轮播文件夹" Command="{Binding BrowseFolder}" Margin="0,0,8,8" Padding="14,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Expander Header="自定义 API 参数">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="自定义壁纸 API" Style="{StaticResource Subheading}"/>
                                    <TextBlock Text="API URL（公网 HTTPS）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Wallpaper.ApiUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="JSON 图片地址字段，例如 data.url" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Wallpaper.JsonPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="请求参数 JSON（字符串字典）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="请求头 JSON（字符串字典）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Headers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="API Key 请求头名称" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Wallpaper.KeyHeader, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="SecretBox" PasswordChanged="KeyChanged"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="更新与缓存" Style="{StaticResource Subheading}"/>
                                <ComboBox SelectedValue="{Binding Wallpaper.Frequency}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="每日更新" Tag="Daily"/>
                                    <ComboBoxItem Content="每次启动更新" Tag="Startup"/>
                                    <ComboBoxItem Content="按周期更新" Tag="Interval"/>
                                    <ComboBoxItem Content="手动更新" Tag="Manual"/>
                                </ComboBox>
                                <TextBlock Text="更新周期（5–10080 分钟）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Wallpaper.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="请求超时（3–120 秒）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Wallpaper.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="保留缓存数量（1–50）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Wallpaper.CacheCount, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel>
                                    <ui:Button Content="保存壁纸配置" Command="{Binding SaveWallpaper}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="立即更新" Command="{Binding RefreshWallpaper}" Appearance="Primary" Margin="0,0,8,8" Padding="14,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="主题库与历史">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="命名主题" Style="{StaticResource Subheading}"/>
                                <TextBlock Text="主题名称" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel>
                                    <ui:Button Content="保存命名主题" Command="{Binding SaveNamed}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="导入 JSON" Command="{Binding Import}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="导出 JSON" Command="{Binding Export}" Margin="0,0,8,8" Padding="14,8"/>
                                </WrapPanel>
                                <ComboBox ItemsSource="{Binding SavedThemes}" SelectedItem="{Binding SelectedSaved}"/>
                                <ui:Button Content="加载主题预览" Command="{Binding LoadNamed}" Margin="0,0,8,8" Padding="14,8"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="历史壁纸" Style="{StaticResource Subheading}"/>
                                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"/>
                                <WrapPanel>
                                    <ui:Button Content="使用历史壁纸" Command="{Binding UseHistory}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="清理壁纸缓存" Command="{Binding ClearCache}" Margin="0,0,8,8" Padding="14,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
