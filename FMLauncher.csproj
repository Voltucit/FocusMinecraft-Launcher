<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>2.0.0</Version>
        <Authors>Voltucit</Authors>
        <Company>Voltucit</Company>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <ApplicationIcon>Assets\Icons\favicon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <IsPackable>false</IsPackable>
        <PackageId>FMLauncher</PackageId>
        <Title>FMLauncher</Title>
        <Description>Minecraft Java Edition launcher</Description>
        <PackageIcon>favicon.ico</PackageIcon>
        <FileVersion>2.0.0.0</FileVersion>
        <Product>FMLauncher</Product>
        <LangVersion>14</LangVersion>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FocusMinecraftCore" Version="1.0.1" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Assets\Icons\favicon.ico"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Developer\services.development.json" LogicalName="FMLauncher.Developer.services.development.json" />
        <EmbeddedResource Include="Developer\services.production.json" LogicalName="FMLauncher.Developer.services.production.json" />
    </ItemGroup>
    <PropertyGroup>
        <PublishTrimmed>false</PublishTrimmed>
        <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
        <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    </PropertyGroup>
</Project>
