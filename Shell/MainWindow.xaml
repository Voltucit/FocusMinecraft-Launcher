<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Shell.MainWindow" Title="FMLauncher" Width="1280" Height="768" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="Transparent" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True" Closing="WindowClosing">
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static nav:NavigationActions.CloseAccounts}" Executed="CloseAccounts"/>
        <CommandBinding Command="{x:Static nav:NavigationActions.OpenNews}" Executed="OpenNews"/>
        <CommandBinding Command="{x:Static nav:NavigationActions.Open}" Executed="OpenPage"/>
        <CommandBinding Command="{x:Static nav:NavigationActions.Back}" Executed="Back" CanExecute="CanBack"/>
        <CommandBinding Command="{x:Static nav:NavigationActions.ReloadSettings}" Executed="ReloadSettings"/>
    </ui:FluentWindow.CommandBindings>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static nav:NavigationActions.Back}"/>
    </ui:FluentWindow.InputBindings>
    <Grid>
        <Border Background="{DynamicResource Canvas}"/>
        <Image Source="{DynamicResource WallpaperImage}" Stretch="UniformToFill" Opacity="{DynamicResource WallpaperOpacity}" IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="{DynamicResource WallpaperBlur}"/>
            </Image.Effect>
        </Image>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <ui:TitleBar Title="FMLauncher" Padding="20,0" ShowMaximize="False" CanMaximize="False" ShowMinimize="True"/>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface}">
                <DockPanel LastChildFill="False" Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                        <Border Width="30" Height="30" Background="{DynamicResource AccentSoft}" CornerRadius="8">
                            <ui:SymbolIcon Symbol="Cube24" Foreground="{DynamicResource Accent}" FontSize="18"/>
                        </Border>
                        <TextBlock Text="FOCUS" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="启动" Tag="Start" GroupName="Section" Style="{StaticResource SectionTab}" Checked="SectionChanged" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Start, Mode=OneWay}"/>
                        <RadioButton Content="下载" Tag="Download" GroupName="Section" Style="{StaticResource SectionTab}" Checked="SectionChanged" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Download, Mode=OneWay}"/>
                        <RadioButton Content="设置" Tag="Settings" GroupName="Section" Style="{StaticResource SectionTab}" Checked="SectionChanged" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Settings, Mode=OneWay}"/>
                        <RadioButton Content="更多" Tag="More" GroupName="Section" Style="{StaticResource SectionTab}" Checked="SectionChanged" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=More, Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="184"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,24,14,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SectionTitle}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,0,0,20"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0">
                            <TextBlock Text="忘却的旋律" FontSize="12"/>
                            <TextBlock Text="专注每一次出发" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1" Margin="{DynamicResource PagePadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Current.Key}" Value="Home"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Command="{x:Static nav:NavigationActions.Back}" ToolTip="返回（Esc）" AutomationProperties.Name="返回上一页" Margin="0,0,12,0" Padding="10,8" VerticalAlignment="Center" Visibility="{Binding CanGoBack, Converter={StaticResource BoolVisibility}}">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"/>
                        </ui:Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Current.Label}" FontWeight="SemiBold" FontSize="22"/>
                            <TextBlock Text="{Binding Current.Description}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ContentControl x:Name="PageContent" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="184"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FMLauncher / 2.0" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Visibility="{Binding Services.Operations.Busy, Converter={StaticResource BoolVisibility}}" Text="{Binding Services.Operations.Status}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                    <ui:Button Grid.Column="2" Content="任务记录" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Tasks" Padding="10,2" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <ui:Button Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Tasks" ToolTip="查看当前下载任务" AutomationProperties.Name="查看当前下载任务" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,52" Padding="0" Width="60" Height="60" CornerRadius="30" Appearance="Primary" Visibility="{Binding Services.Operations.Busy, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20"/>
                <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Services.Operations.Percent, StringFormat={}{0:0}%}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Services.Operations.Indeterminate}" Value="True">
                                    <Setter Property="Text" Value="处理中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ui:Button>
        <Grid x:Name="AccountOverlay" Visibility="Collapsed" Margin="0,38,0,0" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <Border Background="#70000000" MouseLeftButtonDown="DismissAccounts"/>
            <Border x:Name="AccountPanel" Width="440" HorizontalAlignment="Right" Background="{DynamicResource Surface}" Padding="24" CornerRadius="16,0,0,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="我的账号" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><ui:Button Content="关闭" Command="{x:Static nav:NavigationActions.CloseAccounts}" HorizontalAlignment="Right" Padding="10,6" ToolTip="关闭（Esc）"/></Grid>
                    <ContentControl x:Name="AccountContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
