<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Versions.Views.VersionsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SoftCard}" Padding="16,12">
            <DockPanel>
                <ui:SymbolIcon Symbol="Cube24" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                <TextBlock Text="选择一个已安装的版本。使用后返回主页，即可继续启动。" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
            <Grid>
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ListEntry}" AutomationProperties.Name="本地版本列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" Background="{DynamicResource AccentSoft}" CornerRadius="10" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Cube24" Foreground="{DynamicResource Accent}" FontSize="22"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="本地版本" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="还没有本地版本，先前往下载页面安装 Minecraft。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Versions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <WrapPanel>
                <ui:Button Content="使用选中版本" Command="{Binding Use}" Appearance="Primary" Margin="0,0,8,8"/>
                <ui:Button Content="返回主页" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Home" Margin="0,0,8,8"/>
                <ui:Button Content="刷新" Command="{Binding Reload}" Margin="0,0,8,8"/>
                <ui:Button Content="打开版本目录" Command="{Binding OpenFolder}" Margin="0,0,8,8"/>
                <ui:Button Content="打开 mods 目录" Command="{Binding OpenMods}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
        </StackPanel>
    </Grid>
</UserControl>
