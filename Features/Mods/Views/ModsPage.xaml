<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Mods.Views.ModsPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="FILTER / 搜索条件" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="资源平台" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Modrinth" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <TextBlock Text="CurseForge 服务暂未开放。" Style="{StaticResource MutedText}" FontSize="11"/>
                    <TextBlock Text="搜索关键词" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Minecraft 版本（可留空）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Game, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="加载器（可留空）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Loader, UpdateSourceTrigger=PropertyChanged}" ToolTip="fabric / forge / neoforge"/>
                    <ui:Button Content="搜索资源" Command="{Binding Search}" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Expander Header="本地 Mod 文件夹" Margin="0,24,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <ComboBox ItemsSource="{Binding Targets.Versions}" SelectedItem="{Binding Targets.Selected}" DisplayMemberPath="Label"/>
                            <ui:Button Content="打开 mods 目录" Command="{Binding Targets.OpenMods}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="社区搜索结果" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0"/>
                    <WrapPanel Grid.Column="1">
                        <ui:Button Content="上一页" Command="{Binding Previous}" Margin="0,0,8,0"/>
                        <ui:Button Content="下一页" Command="{Binding Next}"/>
                    </WrapPanel>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                    <Expander Header="所选资源简介" Margin="0,12,0,0">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ListEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,8,0,8"/>
                                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="输入关键词，搜索你想了解的 Mod。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
