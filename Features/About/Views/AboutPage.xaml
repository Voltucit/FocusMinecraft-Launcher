<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.About.Views.AboutPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FOCUS / FMLAUNCHER" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="忘却的旋律" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <TextBlock Text="让每一次出发，都更专注。" Style="{StaticResource MutedText}" FontSize="15"/>
                    <Border Style="{StaticResource Tag}" HorizontalAlignment="Left">
                        <TextBlock Text="2.0 · Fluent UI" Foreground="{DynamicResource Accent}" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="项目与致谢" Style="{StaticResource Subheading}"/>
                    <TextBlock Text="开发者：Voltucit。启动核心：FocusMinecraftCore 1.0.1。界面：WPF UI 4.3.0 / .NET 10。开源协议：MIT。" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="Minecraft、Java、Mod 与加载器的权利属于各自权利人。架构、能力边界和人工验证指南见项目 Docs 目录。" Style="{StaticResource MutedText}" Margin="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
