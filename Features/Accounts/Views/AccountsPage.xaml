<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Accounts.Views.AccountsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <TextBlock Text="选择玩家" Style="{StaticResource Subheading}"/>
            <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ListEntry}" MaxHeight="228" AutomationProperties.Name="已保存的账号">
                <ListBox.ItemTemplate><DataTemplate>
                    <ui:Button Click="ChooseAccount" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" IsEnabled="{Binding DataContext.Switch.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Not}}" ToolTip="使用这个账号">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="{DynamicResource AccentSoft}" CornerRadius="9" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource Accent}"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                    </ui:Button>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,8,0,14">
                <ui:Button Content="设为默认" Command="{Binding SetDefault}" Margin="0,0,8,6" Padding="10,6"/>
                <ui:Button Content="删除账号…" Command="{Binding Delete}" Margin="0,0,8,6" Padding="10,6"/>
            </WrapPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,20"/>
            <ui:Button Content="Microsoft 正版登录" Command="{Binding Login}" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10"/>
            <StackPanel Visibility="{Binding Login.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                <TextBlock Text="{Binding DeviceText}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Accent}"/>
                <WrapPanel Margin="0,10,0,4"><ui:Button Content="打开授权页面" Command="{Binding OpenLogin}" Margin="0,0,8,6"/><ui:Button Content="取消登录" Command="{Binding Cancel}" Margin="0,0,8,6"/></WrapPanel>
            </StackPanel>
            <Expander Header="添加离线账号" Margin="0,18,0,0">
                <StackPanel Margin="0,12,0,0"><TextBlock Text="玩家名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/><TextBlock Text="3–16 位字母、数字或下划线。" Style="{StaticResource MutedText}" FontSize="11"/><ui:Button Content="添加并使用" Command="{Binding AddOffline}"/></StackPanel>
            </Expander>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
