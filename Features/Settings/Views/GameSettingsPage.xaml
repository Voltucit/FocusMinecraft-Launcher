<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Settings.Views.GameSettingsPage">
    <DockPanel MaxWidth="720" HorizontalAlignment="Left">
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel>
                <ui:Button Content="保存启动设置" Command="{Binding Save}" Appearance="Primary" Margin="0,0,8,8" Padding="14,8"/>
                <ui:Button Content="重新读取已保存设置" Command="{x:Static nav:NavigationActions.ReloadSettings}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
        </StackPanel>
        <TabControl Margin="0,0,0,12">
            <TabItem Header="Java 与内存">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Java 运行环境" Style="{StaticResource Subheading}"/>
                                <TextBlock Text="Java 路径（留空选择兼容的已安装环境）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.JavaPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel>
                                    <ui:Button Content="浏览 Java" Command="{Binding BrowseJava}" Margin="0,0,8,8" Padding="14,8"/>
                                    <ui:Button Content="管理运行环境" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Java" Margin="0,0,8,8"/>
                                </WrapPanel>

                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="内存分配" Style="{StaticResource Subheading}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最小内存 MiB（0 表示不指定）" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.MinMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="最大内存 MiB" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="这些启动设置将应用于全部版本。" Style="{StaticResource MutedText}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="窗口与服务器">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="游戏窗口" Style="{StaticResource Subheading}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="窗口宽度" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Width, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="窗口高度" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Height, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="以全屏启动" IsChecked="{Binding Settings.Fullscreen}"/>
                                <CheckBox Content="关闭启动器后保留游戏进程" IsChecked="{Binding Settings.KeepGamesOnExit}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动加入服务器" Style="{StaticResource Subheading}"/>
                                <TextBlock Text="服务器地址（留空关闭）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.ServerHost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="服务器端口" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.ServerPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="高级参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="启动参数" Style="{StaticResource Subheading}"/>
                                <TextBlock Text="Java 主版本（仅在版本信息缺少要求时使用，可留空）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.FallbackJavaMajor, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="JVM 参数：每行一个完整参数" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.JvmArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="游戏参数：每行一个完整参数" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.GameArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="带空格的参数保持为同一行，不添加 Shell 引号。" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
