<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Settings.Views.SettingsPage">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="680" HorizontalAlignment="Left">
<TextBlock Text="游戏文件夹" Style="{StaticResource Subheading}"/>
<TextBlock Text="新安装的游戏会保存在这里。更改位置不会移动已有游戏。" Style="{StaticResource MutedText}"/>
<TextBox Text="{Binding Settings.GameRoot, UpdateSourceTrigger=PropertyChanged}" MinWidth="360"/>
<WrapPanel><ui:Button Content="选择文件夹" Command="{Binding BrowseRoot}" Margin="0,0,8,16"/><ui:Button Content="导入旧版配置" Command="{Binding ImportLegacy}" Margin="0,0,8,16"/></WrapPanel>
<WrapPanel Margin="0,12,0,0"><ui:Button Content="保存设置" Command="{Binding Save}" Appearance="Primary" Margin="0,0,8,8"/><ui:Button Content="放弃修改并重新读取" Command="{x:Static nav:NavigationActions.ReloadSettings}" Margin="0,0,8,8"/></WrapPanel>
<TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
</StackPanel></ScrollViewer></UserControl>
