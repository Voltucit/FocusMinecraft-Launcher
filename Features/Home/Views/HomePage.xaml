<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Home.Views.HomePage">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="准备出发" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,22"/>
                    <ui:Button Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Accounts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" ToolTip="登录或切换账号">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource Accent}" FontSize="26"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Accounts.Current.Name, TargetNullValue=登录或添加账号}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Accounts.Current.KindLabel, TargetNullValue=选择你的玩家身份}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16"/>
                        </Grid>
                    </ui:Button>
                    <TextBlock Text="当前游戏" Style="{StaticResource FieldLabel}" Margin="0,28,0,10"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{DynamicResource AccentSoft}" CornerRadius="12" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Cube24" Foreground="{DynamicResource Accent}" FontSize="26"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version.Id, TargetNullValue=还没有选择版本}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Version.Summary, TargetNullValue=先下载 Minecraft 或选择本地版本}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ui:Button Content="版本选择" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Versions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,9"/>
                        <ui:Button Grid.Column="2" Content="游戏设置" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="GameSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,9"/>
                    </Grid>
                    <ui:Button Content="启动游戏" Command="{Binding Launch}" Appearance="Primary" FontSize="19" Padding="16,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource DefaultButtonStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasVersion}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsGameActive}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers></Style></ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="停止 / 取消启动" Command="{Binding Stop}" Visibility="{Binding IsGameActive, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="12" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource SoftCard}" Padding="26" MinHeight="230">
                    <Grid>
                        <Path Fill="{DynamicResource Accent}" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Data="M0,140 L0,100 L30,100 L30,60 L70,60 L70,85 L110,85 L110,25 L150,25 L150,50 L185,50 L185,0 L230,0 L230,85 L260,85 L260,140 Z"/>
                        <StackPanel MaxWidth="430" HorizontalAlignment="Left">
                            <TextBlock Text="MINECRAFT" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="继续你的世界" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,14"/>
                            <TextBlock Text="熟悉的方块，新的冒险。登录账号、选好版本，就从这里出发。" Style="{StaticResource MutedText}" MaxWidth="320" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Minecraft 资讯" Style="{StaticResource Subheading}"/>
                        <TextBlock Text="在 Minecraft 官网阅读游戏更新、社区故事与最新消息。" Style="{StaticResource MutedText}"/>
                        <ui:Button Content="查看官方资讯 ↗" Command="{x:Static nav:NavigationActions.OpenNews}" Padding="12,8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22" Margin="0">
                    <StackPanel>
                        <TextBlock Text="开始新的旅程" Style="{StaticResource Subheading}"/>
                        <TextBlock Text="选择一个 Minecraft 版本，也可以为它搭配兼容的加载器。" Style="{StaticResource MutedText}"/>
                        <ui:Button Content="下载 Minecraft" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Downloads" Padding="12,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
