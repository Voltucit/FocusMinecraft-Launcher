<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="FMLauncher.Features.Home.Views.DiagnosticsPage">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{Binding Version.Id, TargetNullValue=先在版本选择中选择游戏}" Style="{StaticResource Subheading}"/>
            <WrapPanel><ui:Button Content="打开游戏文件夹" Command="{Binding OpenFolder}" Margin="0,0,8,8"/><ui:Button Content="检查文件" Command="{Binding Verify}" Margin="0,0,8,8"/><ui:Button Content="修复文件" Command="{Binding Repair}" Margin="0,0,8,8"/><ui:Button Content="重新读取版本" Command="{Binding Reload}" Margin="0,0,8,8"/></WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
        </StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0"><DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="本次游戏输出" Style="{StaticResource Subheading}"/>
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </DockPanel></Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><ui:Button Content="导出本次日志…" Command="{Binding ExportLogs}"/><Expander Header="高级诊断" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Version.ErrorCode, TargetNullValue=版本元数据没有报告错误码}" TextWrapping="Wrap"/><TextBlock Text="原始代码仅用于排查问题；启动时的中文提示会保留失败类别。" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Expander></StackPanel>
    </Grid>
</UserControl>
