<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Downloads.Views.DownloadsPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Minecraft 版本" Style="{StaticResource Eyebrow}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox SelectedValue="{Binding Filter}" SelectedValuePath="Tag" Margin="0,0,10,14" AutomationProperties.Name="Minecraft 版本分类">
                            <ComboBoxItem Content="正式版" Tag="release"/>
                            <ComboBoxItem Content="快照版" Tag="snapshot"/>
                            <ComboBoxItem Content="全部版本" Tag="all"/>
                            <ComboBoxItem Content="远古 Beta" Tag="old_beta"/>
                            <ComboBoxItem Content="远古 Alpha" Tag="old_alpha"/>
                        </ComboBox>
                        <ui:Button Grid.Column="1" Content="获取版本列表" Command="{Binding Reload}" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="11"/>
                <Grid>
                    <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ListEntry}" AutomationProperties.Name="可下载的 Minecraft 版本">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Cube24" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Released, StringFormat={}{0:yyyy年MM月dd日}}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding InstallState}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="点击“获取版本列表”，获取可安装的版本。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Versions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <ui:Button Content="开始安装" Command="{Binding Install}" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="20,11"/>
                    <ui:Button Content="查看任务管理" Command="{x:Static nav:NavigationActions.Open}" CommandParameter="Tasks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="安装选项" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Selected.Id, TargetNullValue=请先选择游戏版本}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,20"/>
                        <TextBlock Text="{Binding Selected.InstallState}" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/>
                        <TextBlock Text="版本类型" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedValue="{Binding Kind}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Minecraft 原版" Tag="Vanilla"/>
                            <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                            <ComboBoxItem Content="Forge" Tag="Forge"/>
                            <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                            <ComboBoxItem Content="OptiFine" Tag="OptiFine"/>
                        </ComboBox>
                        <Expander Header="加载器版本" IsExpanded="True">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="选择加载器后查询可用版本；原版无需选择组件。" Style="{StaticResource MutedText}" FontSize="11"/>
                                <ui:Button Content="查询兼容版本" Command="{Binding QueryLoaders}" Margin="0,0,0,12"/>
                                <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" AutomationProperties.Name="加载器版本"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="加载器版本目录名（可选）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="原版保留官方版本 ID。安装使用当前启动设置中选择的 Java。" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
