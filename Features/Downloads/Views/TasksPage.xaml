<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Downloads.Views.TasksPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CURRENT TASK / 当前任务" Style="{StaticResource Eyebrow}"/>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,12,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="等待下一次出发"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Operations.Busy}" Value="True">
                                        <Setter Property="Text" Value="正在处理文件"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="{Binding Operations.Percent, Mode=OneWay}" IsIndeterminate="{Binding Operations.Indeterminate, Mode=OneWay}" Height="6" Visibility="{Binding Operations.Busy, Converter={StaticResource BoolVisibility}}"/>
                    <TextBlock Text="{Binding Operations.Status}" Style="{StaticResource MutedText}" Margin="0,20,0,16"/>
                    <ui:Button Content="取消当前操作" Command="{Binding Cancel}" IsEnabled="{Binding Operations.Busy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="切换页面不会中断任务。" Style="{StaticResource MutedText}" Margin="0,20,0,0" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="最近操作" Style="{StaticResource Subheading}"/>
                <Grid>
                    <ListBox ItemsSource="{Binding Operations.History}" ItemContainerStyle="{StaticResource ListEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="还没有操作记录。安装、校验和修复的结果会显示在这里。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Operations.History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
