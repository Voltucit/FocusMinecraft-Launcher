<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:nav="clr-namespace:FMLauncher.Navigation" x:Class="FMLauncher.Features.Modpacks.Views.ModpacksPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource SoftCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" Background="{DynamicResource AccentSoft}" CornerRadius="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <ui:SymbolIcon Symbol="Box24" Foreground="{DynamicResource Accent}" FontSize="26"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="先了解整合包，再决定下一步" Style="{StaticResource Subheading}"/>
                        <TextBlock Text="读取 mrpack v1 或 CurseForge manifest v1 的清单信息。当前页面保留已有只读能力。" Style="{StaticResource MutedText}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="本地文件" Style="{StaticResource Subheading}"/>
                    <TextBlock Text="整合包文件路径" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Archive, UpdateSourceTrigger=PropertyChanged}"/>
                    <WrapPanel>
                        <ui:Button Content="选择文件" Command="{Binding Browse}" Margin="0,0,8,8"/>
                        <ui:Button Content="读取清单" Command="{Binding Read}" Appearance="Primary" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="清单解析结果" Style="{StaticResource Subheading}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" LineHeight="24"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
